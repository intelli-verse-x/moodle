<script>
(function () {
    var body = document.body;
    if (!body) {
        return;
    }
    var id = body.id || '';
    var path = body.className || '';
    var isForgot = id === 'page-login-forgot_password' || path.indexOf('path-login-forgot_password') !== -1;
    var isSet = id === 'page-login-set_password' || path.indexOf('path-login-set_password') !== -1
        || body.classList.contains('lp-set-password')
        || !!document.getElementById('id_password2');
    if (isSet) {
        body.classList.add('lp-set-password');
    }
    if (!isForgot && !isSet) {
        return;
    }
    var container = document.querySelector('.login-container') || document.querySelector('#region-main');
    if (!container) {
        return;
    }
    container.classList.add('toba-forgotform', 'toba-loginform');

    container.querySelectorAll('.generalbox, .boxwidthnormal').forEach(function (el) {
        if (el.closest('form')) {
            return;
        }
        el.remove();
    });

    var head = container.querySelector('[data-toba-forgot-head]');
    var form = container.querySelector('form.mform') || container.querySelector('form');
    // Never insertBefore onto the wrong parent — that throws and aborts placeholders.
    try {
        if (head && form && head.parentNode !== form.parentNode) {
            form.parentNode.insertBefore(head, form);
        }
    } catch (e) { /* keep head where Moodle rendered it */ }

    function lpSetForgotPlaceholders() {
        if (!isForgot) {
            return;
        }
        var root = form || container;
        var user = root.querySelector('#id_username') || root.querySelector('input[name="username"]');
        var email = root.querySelector('#id_email') || root.querySelector('input[name="email"]');
        if (user) {
            user.setAttribute('placeholder', 'Enter your username');
        }
        if (email) {
            email.setAttribute('placeholder', 'Enter your email');
        }
    }
    lpSetForgotPlaceholders();
    setTimeout(lpSetForgotPlaceholders, 0);
})();
</script>
