{{!
    @template local_launchpad/portal_notification_prefs

    LaunchPad notification preferences (popup + email quick toggles).
}}
<div class="lp-tools-page lp-reveal" data-region="portal-notification-prefs" style="--lp-d:0">
  <div class="lp-profile-pref-back">
    <a class="lp-btn lp-btn-light" href="{{back_url}}">
      <iconify-icon icon="hugeicons:arrow-left-01" width="16" height="16" aria-hidden="true"></iconify-icon>
      {{back_label}}
    </a>
  </div>

  {{#has_flash}}
    {{#flash}}
      <div class="lp-flash{{#ok}} is-ok{{/ok}}{{^ok}} is-err{{/ok}}" role="status">{{text}}</div>
    {{/flash}}
  {{/has_flash}}

  <form class="lp-card lift lp-profile-form lp-profile-pref-form" method="post" action="{{action_url}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="view" value="notificationprefs">
    <input type="hidden" name="action" value="save_notification_preferences">
    <div class="lp-card-head">
      <div class="lp-grade-progress-title">
        <span class="lp-grade-progress-icon" aria-hidden="true">
          <iconify-icon icon="hugeicons:notification-01" width="22" height="22"></iconify-icon>
        </span>
        <div class="lp-card-copy">
          <h3>{{title}}</h3>
          <p>{{help}}</p>
        </div>
      </div>
      <a class="lp-btn lp-btn-light" href="{{advanced_url}}">{{advanced_label}}</a>
    </div>

    <div class="lp-profile-form-grid">
      <label class="lp-field lp-field-check">
        <span class="lp-field-check-row">
          <input type="checkbox" name="popup_enabled" value="1" {{#popup_checked}}checked{{/popup_checked}}>
          <span>{{popup_label}}</span>
        </span>
      </label>
      <label class="lp-field lp-field-check">
        <span class="lp-field-check-row">
          <input type="checkbox" name="email_enabled" value="1" {{#email_checked}}checked{{/email_checked}}>
          <span>{{email_label}}</span>
        </span>
      </label>
    </div>

    <div class="lp-profile-form-actions">
      <button type="submit" class="lp-btn lp-btn-primary">{{save_label}}</button>
    </div>
  </form>
</div>
