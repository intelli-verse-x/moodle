{{!
    @template local_launchpad/portal_mismatch_modal

    Wrong-portal notice: ToBa modal over the user's real home.
}}
{{#show_portal_mismatch}}
<div class="lp-portal-mismatch is-open" data-lp-portal-mismatch role="presentation">
  <div class="lp-portal-mismatch-scrim" data-lp-portal-mismatch-dismiss aria-hidden="true"></div>
  <div class="lp-portal-mismatch-card" role="dialog" aria-modal="true"
       aria-labelledby="lp-portal-mismatch-title" aria-describedby="lp-portal-mismatch-body">
    <p class="lp-eyebrow">{{#str}} portal_mismatch_eyebrow, local_launchpad {{/str}}</p>
    <h2 id="lp-portal-mismatch-title">{{portal_mismatch_title}}</h2>
    <p id="lp-portal-mismatch-body" class="lp-sm">{{portal_mismatch_body}}</p>
    <div class="lp-portal-mismatch-actions">
      <button type="button" class="lp-btn lp-btn-primary" data-lp-portal-mismatch-dismiss>
        {{portal_mismatch_continue}}
      </button>
    </div>
  </div>
</div>
{{/show_portal_mismatch}}
