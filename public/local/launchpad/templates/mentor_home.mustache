{{!
    @template local_launchpad/mentor_home
}}
{{^has_courses}}
  <div class="lp-empty" role="status">
    <div class="lp-empty-mark" aria-hidden="true">MN</div>
    <h2>{{welcome_back}}</h2>
    <p>{{#str}} mentor_area_no_courses, local_launchpad {{/str}}</p>
  </div>
{{/has_courses}}
{{#has_courses}}
  <div class="lp-hero">
    <div class="lp-hero-row">
      <div class="lp-hero-main">
        <span class="lp-eyebrow">{{#str}} mentor_role_label, local_launchpad {{/str}}</span>
        <h2>{{welcome_back}}</h2>
        <p class="lp-hero-lead">{{#str}} mentor_home_lead, local_launchpad {{/str}}</p>
        {{#has_waiting}}
          <div class="lp-quest">
            <div>
              <span class="lp-eyebrow">{{#str}} mentor_waiting_eyebrow, local_launchpad {{/str}}</span>
              <p class="lp-quest-title">{{waiting_label}}</p>
              <p class="lp-muted">{{#str}} mentor_waiting_hint, local_launchpad {{/str}}</p>
            </div>
            <a class="lp-btn lp-btn-primary" href="{{queue_url}}">{{#str}} mentor_open_queue, local_launchpad {{/str}}</a>
          </div>
        {{/has_waiting}}
        {{^has_waiting}}
          <p class="lp-muted">{{#str}} mentor_queue_caught_up, local_launchpad {{/str}}</p>
        {{/has_waiting}}
      </div>
    </div>
  </div>

  <div class="lp-stats" role="list">
    <div class="lp-stat" role="listitem">
      <b>{{waiting_count}}</b>
      <span>{{#str}} mentor_stat_waiting, local_launchpad {{/str}}</span>
    </div>
    <div class="lp-stat" role="listitem">
      <b>{{released_count}}</b>
      <span>{{#str}} mentor_stat_released, local_launchpad {{/str}}</span>
    </div>
    <div class="lp-stat" role="listitem">
      <b>{{open_count}}</b>
      <span>{{#str}} mentor_stat_open, local_launchpad {{/str}}</span>
    </div>
  </div>

  {{#has_waiting}}
    <section class="lp-card lift">
      <div class="lp-card-head">
        <h3>{{#str}} mentor_waiting_preview, local_launchpad {{/str}}</h3>
        <a class="lp-link" href="{{queue_url}}">{{#str}} mentor_nav_queue, local_launchpad {{/str}} →</a>
      </div>
      <ul class="lp-course-list">
        {{#waiting_preview}}
          <li>
            <a href="{{url}}">
              <b>{{{fellow_name}}}</b>
              <span class="lp-muted">{{{assign_name}}} · {{submitted_at}}</span>
            </a>
          </li>
        {{/waiting_preview}}
      </ul>
    </section>
  {{/has_waiting}}

  <section class="lp-card lift" style="margin-top:16px">
    <div class="lp-card-head">
      <h3>{{#str}} mentor_your_courses, local_launchpad {{/str}}</h3>
    </div>
    <ul class="lp-course-list">
      {{#courses}}
        <li>
          <a href="{{moodle_url}}">
            <b>{{{fullname}}}</b>
            <span class="lp-muted">{{idnumber}}</span>
          </a>
        </li>
      {{/courses}}
    </ul>
  </section>
{{/has_courses}}
