{{!
    @template local_launchpad/admin_tracks

    Admin Tracks & courses — clean dashboard (Stitch-inspired, LP theme).
    Navbar stays in admin_shell. Live data only (no fake sync/docs chrome).
}}
<div class="lp-tr" data-region="local-launchpad-admin-tracks" data-lp-tracks-page>

  <section class="lp-hero lp-tr-hero">
    <div class="lp-hero-row">
      <div class="lp-hero-main">
        <span class="lp-eyebrow">{{eyebrow}}</span>
        <h2>{{heading}}</h2>
        <p class="lp-hero-lead">{{lead}}</p>
        <p class="lp-sm lp-tr-cat">
          <span class="lp-chip {{category_chip_class}}">{{category_chip}}</span>
        </p>
      </div>
      <aside class="lp-tr-hero-stats" aria-label="{{heading}}">
        <div class="lp-tr-hero-stat">
          <span class="lp-tr-hero-stat-label">{{stat_tracks_label}}</span>
          <b>{{stat_tracks_value}}</b>
        </div>
        <div class="lp-tr-hero-stat">
          <span class="lp-tr-hero-stat-label">{{stat_ready_label}}</span>
          <div class="lp-tr-hero-stat-line">
            <b>{{stat_ready_value}}</b>
            <span class="lp-tr-hero-stat-sub is-ok">{{stat_ready_sub}}</span>
          </div>
        </div>
        <div class="lp-tr-hero-stat">
          <span class="lp-tr-hero-stat-label">{{stat_outline_label}}</span>
          <div class="lp-tr-hero-stat-line">
            <b>{{stat_outline_value}}</b>
            <span class="lp-tr-hero-stat-sub is-warn">{{stat_outline_sub}}</span>
          </div>
        </div>
        <div class="lp-tr-hero-stat">
          <span class="lp-tr-hero-stat-label">{{stat_fellows_label}}</span>
          <div class="lp-tr-hero-stat-line">
            <b>{{stat_fellows_value}}</b>
            <span class="lp-tr-hero-stat-sub">{{stat_fellows_sub}}</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {{#flash_ok}}
    <div class="lp-flash is-ok" role="status">{{flash_ok_body}}</div>
  {{/flash_ok}}
  {{#flash_err}}
    <div class="lp-flash is-err" role="alert">{{flash_err_body}}</div>
  {{/flash_err}}

  {{#has_orientation}}
    <section class="lp-tr-grid-wrap lp-tr-orient-wrap" aria-label="{{orientation_title}}">
      <div class="lp-tr-grid-head">
        <div>
          <h3>{{orientation_title}}</h3>
          <p class="lp-muted lp-sm">{{orientation_lead}}</p>
          <p class="lp-muted lp-sm">{{orientation_help}}</p>
        </div>
      </div>
      <div class="lp-tr-orient-grid">
        {{#orientation_courses}}
          <article class="lp-tr-card lp-tr-orient-card{{^is_visible}} is-hidden-course{{/is_visible}}" data-lp-tr-orient-card>
            <div class="lp-tr-card-top">
              <span class="lp-tr-status lp-tr-status-orient">{{badge}}</span>
              <span class="lp-tr-vis{{#is_visible}} is-on{{/is_visible}}{{^is_visible}} is-off{{/is_visible}}">{{visibility_label}}</span>
            </div>
            <div class="lp-tr-card-titles">
              <h3>{{name}}</h3>
              <div class="lp-tr-codes">
                {{#idnumber}}<code class="lp-tr-idn">{{idnumber}}</code>{{/idnumber}}
                {{#shortname}}<code class="lp-tr-idn">{{shortname}}</code>{{/shortname}}
              </div>
            </div>
            <div class="lp-tr-meta lp-tr-meta-single">
              <div class="lp-tr-meta-row">
                <span class="lp-tr-section-label">{{enrolled_section_label}}</span>
                <span class="lp-tr-meta-value{{#fellows_count}} is-enrolled{{/fellows_count}}">{{fellows_label}}</span>
              </div>
            </div>
            <div class="lp-tr-card-foot">
              <div class="lp-tr-card-actions">
                {{#is_visible}}
                  <form method="post" action="{{form_action}}" class="lp-inline-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="structure_hide">
                    <input type="hidden" name="cohort" value="{{cohort_value}}">
                    <input type="hidden" name="courseid" value="{{id}}">
                    <button type="submit" class="lp-btn lp-btn-light lp-btn-sm">{{hide_label}}</button>
                  </form>
                {{/is_visible}}
                {{#is_hidden}}
                  <form method="post" action="{{form_action}}" class="lp-inline-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="structure_unhide">
                    <input type="hidden" name="cohort" value="{{cohort_value}}">
                    <input type="hidden" name="courseid" value="{{id}}">
                    <button type="submit" class="lp-btn lp-btn-solid lp-btn-sm">{{show_label}}</button>
                  </form>
                {{/is_hidden}}
                <a class="lp-btn lp-btn-light lp-btn-sm" href="{{courseops_url}}">{{courseops_label}}</a>
              </div>
              <a class="lp-tr-preview-link" href="{{course_url}}">{{open_label}}</a>
            </div>
          </article>
        {{/orientation_courses}}
      </div>
    </section>
  {{/has_orientation}}

  {{#has_tracks}}
    <section class="lp-tr-grid-wrap">
      <div class="lp-tr-grid-head">
        <div>
          <h3>{{grid_title}}</h3>
          <p class="lp-muted lp-sm">{{grid_lead}}</p>
        </div>
        <div class="lp-tr-filters" role="tablist" aria-label="{{grid_title}}">
          <button type="button" class="lp-tr-filter is-active" data-lp-tr-filter="all" role="tab" aria-selected="true">{{filter_all_label}}</button>
          <button type="button" class="lp-tr-filter" data-lp-tr-filter="ready" role="tab" aria-selected="false">{{filter_ready_label}}</button>
          <button type="button" class="lp-tr-filter" data-lp-tr-filter="outline" role="tab" aria-selected="false">{{filter_outline_label}}</button>
        </div>
      </div>

      <div class="lp-tr-grid">
        {{#tracks}}
          <article class="lp-tr-card{{#ready}} is-ready{{/ready}}{{^ready}} is-outline{{/ready}}{{^is_visible}} is-hidden-course{{/is_visible}}"
            data-lp-tr-card
            data-lp-tr-status="{{status_key}}">
            <div class="lp-tr-card-top">
              <span class="lp-tr-status lp-tr-status-{{status_key}}">{{ready_label}}</span>
              <span class="lp-tr-phases-pill">{{phases_shown_label}}</span>
            </div>

            <div class="lp-tr-card-titles">
              <h3>{{name}}</h3>
              <div class="lp-tr-codes">
                {{#idnumber}}<code class="lp-tr-idn">{{idnumber}}</code>{{/idnumber}}
                {{#shortname}}<code class="lp-tr-idn">{{shortname}}</code>{{/shortname}}
                <span class="lp-tr-vis{{#is_visible}} is-on{{/is_visible}}{{^is_visible}} is-off{{/is_visible}}">{{visibility_label}}</span>
              </div>
            </div>

            <p class="lp-tr-capstone">{{capstone}}</p>

            <div class="lp-tr-phases">
              <span class="lp-tr-section-label">{{phases_section_label}}</span>
              <div class="lp-tr-phdots" aria-label="{{phases_shown_label}}">
                {{#phases}}
                  <i class="{{#on}}on{{/on}}" title="{{title}}"></i>
                {{/phases}}
              </div>
            </div>

            <div class="lp-tr-meta lp-tr-meta-grid">
              <div class="lp-tr-meta-row">
                <span class="lp-tr-section-label">{{mentors_section_label}}</span>
                {{#has_teacher}}
                  <span class="lp-tr-meta-value">{{teacher_label}}</span>
                {{/has_teacher}}
                {{^has_teacher}}
                  <a class="lp-tr-assign" href="{{assign_teacher_url}}">{{assign_teacher_label}}</a>
                {{/has_teacher}}
              </div>
              <div class="lp-tr-meta-row">
                <span class="lp-tr-section-label">{{enrolled_section_label}}</span>
                <span class="lp-tr-meta-value{{#fellows_count}} is-enrolled{{/fellows_count}}">{{fellows_label}}</span>
              </div>
            </div>

            <div class="lp-tr-card-foot">
              <div class="lp-tr-card-actions">
                <a class="lp-btn lp-btn-solid lp-btn-sm" href="{{courseops_url}}">{{courseops_label}}</a>
                <a class="lp-btn lp-btn-light lp-btn-sm" href="{{builder_url}}">{{builder_label}}</a>
              </div>
              <a class="lp-tr-preview-link" href="{{course_url}}">{{open_label}}</a>
            </div>
          </article>
        {{/tracks}}

        <a class="lp-tr-builder-tile" href="{{builder_url}}">
          <span class="lp-tr-builder-ico" aria-hidden="true">+</span>
          <b>{{builder_tile_title}}</b>
          <span class="lp-muted lp-sm">{{builder_tile_body}}</span>
          <span class="lp-tr-builder-cta">{{builder_tile_cta}}</span>
        </a>
      </div>
      <p class="lp-tr-filter-empty" data-lp-tr-empty hidden>{{filter_empty}}</p>
    </section>
  {{/has_tracks}}
  {{^has_tracks}}
    <div style="margin-top:4px">
      {{> local_launchpad/admin_empty}}
    </div>
  {{/has_tracks}}

  {{#has_danger}}
    <section class="lp-tr-danger" aria-label="{{danger_title}}">
      <div class="lp-tr-danger-head">
        <h3><span class="lp-tr-danger-dot" aria-hidden="true"></span>{{danger_title}}</h3>
        <p class="lp-muted lp-sm">{{danger_lead}}</p>
      </div>
      <div class="lp-st-danger-list">
        {{#danger_rows}}
          <article class="lp-st-danger-row{{#is_hidden}} is-delete-ready{{/is_hidden}}">
            <div class="lp-st-danger-meta">
              <p class="lp-st-danger-name"><b>{{fullname}}</b>
                <span class="lp-muted lp-sm"> · {{kind_label}}</span>
              </p>
              <p class="lp-st-danger-meta-line lp-sm lp-muted">
                <code class="lp-tr-idn">{{idnumber}}</code>
                <span class="lp-st-danger-sep" aria-hidden="true">·</span>
                <span>{{enrol_count_label}}</span>
                <span class="lp-st-danger-sep" aria-hidden="true">·</span>
                <span class="lp-st-vis{{#is_visible}} is-on{{/is_visible}}{{^is_visible}} is-off{{/is_visible}}">{{visibility_label}}</span>
              </p>
            </div>
            <div class="lp-st-danger-actions">
              {{#is_visible}}
                <p class="lp-sm lp-muted lp-tr-danger-hint">{{danger_delete_need_hide}}</p>
                <form method="post" action="{{form_action}}" class="lp-inline-form">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <input type="hidden" name="action" value="structure_hide">
                  <input type="hidden" name="cohort" value="{{cohort_value}}">
                  <input type="hidden" name="courseid" value="{{courseid}}">
                  <button type="submit" class="lp-btn lp-btn-light lp-btn-sm">{{danger_hide_label}}</button>
                </form>
              {{/is_visible}}
              {{#is_hidden}}
                <form method="post" action="{{form_action}}" class="lp-inline-form">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <input type="hidden" name="action" value="structure_unhide">
                  <input type="hidden" name="cohort" value="{{cohort_value}}">
                  <input type="hidden" name="courseid" value="{{courseid}}">
                  <button type="submit" class="lp-btn lp-btn-light lp-btn-sm">{{danger_unhide_label}}</button>
                </form>
                <form method="post" action="{{form_action}}" class="lp-st-danger-delete">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <input type="hidden" name="action" value="structure_delete">
                  <input type="hidden" name="cohort" value="{{cohort_value}}">
                  <input type="hidden" name="courseid" value="{{courseid}}">
                  <p class="lp-sm lp-st-danger-warn">{{danger_delete_warn}}</p>
                  <label class="lp-field">
                    <span>{{danger_confirm_label}}</span>
                    <input type="text" name="confirmtext" value="" required maxlength="200" autocomplete="off" placeholder="{{idnumber}}">
                  </label>
                  <p class="lp-sm lp-muted">{{danger_confirm_help}}</p>
                  <button type="submit" class="lp-btn lp-btn-sm lp-btn-danger-solid">{{danger_delete_label}}</button>
                </form>
              {{/is_hidden}}
            </div>
          </article>
        {{/danger_rows}}
      </div>
    </section>
  {{/has_danger}}

  <aside class="lp-tr-footer-tip" aria-label="{{footer_tip}}">
    <span class="lp-tr-footer-ico" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
    </span>
    <p>{{footer_tip}}</p>
  </aside>
</div>
