{{!
    @template local_launchpad/employer_nav

    Employer sidebar chrome (dark navy). Icons: Hugeicons via Iconify.
    Single scroll flow (Fellowship): logo → role → progress → nav → profile → sign out.
}}
<nav class="lp-side" id="lp-side" aria-label="{{strings.navaria}}">
  <a class="lp-logo" href="{{urls.home}}">
    <img class="lp-logo-img" src="{{assets}}/logo-on-dark.png" alt="ToBa Learn" width="106" height="40">
  </a>
  <div class="lp-role">{{rolelabel}}</div>

  <a class="lp-lvcard" href="{{sidecard.url}}" title="{{sidecard.title}}">
    <div class="lp-lvcard-row">
      <span class="lp-lvbadge" style="background:{{sidecard.color}}" aria-hidden="true">{{sidecard.badge}}</span>
      <div class="lp-lvcard-text">
        <b>{{sidecard.name}}</b>
        <span>{{sidecard.meta}}</span>
      </div>
    </div>
    <div class="lp-side-xpbar" aria-hidden="true"><i style="width:{{sidecard.pct}}%"></i></div>
  </a>

  {{#nav_groups}}
    <div class="lp-nl">{{group}}</div>
    {{#items}}
      <a class="lp-nav{{#current}} is-current{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>
        {{#icon_svg}}{{{icon_svg}}}{{/icon_svg}}
        <span>{{label}}</span>
        {{#has_badge}}<span class="lp-nav-badge">{{badge}}</span>{{/has_badge}}
      </a>
    {{/items}}
  {{/nav_groups}}

  <div class="lp-side-foot">
    {{#profile_menu_side}}
      {{> local_launchpad/profile_menu }}
    {{/profile_menu_side}}
  </div>
</nav>
