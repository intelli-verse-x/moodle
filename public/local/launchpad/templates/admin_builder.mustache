{{!
    @template local_launchpad/admin_builder

    Admin Course builder overview - Stitch layout.
    All phases stacked, track pills, right summary rail.
    Navbar stays in admin_shell. Keep comments free of Mustache braces.
}}
<div class="lp-cb" data-lp-builder data-lp-builder-active="{{initial_trackid}}" data-region="local-launchpad-admin-builder">
  <section class="lp-hero lp-cb-hero">
    <div class="lp-hero-row">
      <div class="lp-hero-main">
        <span class="lp-eyebrow">{{eyebrow}}</span>
        <h2>{{heading}}</h2>
        <p class="lp-hero-lead">{{lead}}</p>
      </div>
    </div>
  </section>

  {{#flash_ok}}
    <div class="lp-flash is-ok" role="status">{{flash_ok_body}}</div>
  {{/flash_ok}}
  {{#flash_err}}
    <div class="lp-flash is-err" role="alert">{{flash_err_body}}</div>
  {{/flash_err}}

  {{#show_create_track}}
    <section class="lp-card lift lp-cb-create" data-region="builder-create-track">
      <div class="lp-card-head">
        <h3>{{create_title}}</h3>
        <p class="lp-sm lp-muted">{{create_help}}</p>
      </div>
      <form method="post" action="{{create_action}}" class="lp-cb-create-form">
        <input type="hidden" name="sesskey" value="{{create_sesskey}}">
        <input type="hidden" name="action" value="create_track">
        <div class="lp-cb-create-grid">
          <label class="lp-field">
            <span>{{create_name_label}}</span>
            <input type="text" name="trackname" required maxlength="200" list="lp-cb-known-tracks" placeholder="e.g. AI &amp; Automation">
            <datalist id="lp-cb-known-tracks">
              {{#known_tracks}}
                <option value="{{name}}"></option>
              {{/known_tracks}}
            </datalist>
          </label>
          <label class="lp-field">
            <span>{{create_cohort_label}}</span>
            <input type="text" name="cohort" required maxlength="80" value="{{create_cohort_value}}">
          </label>
          <label class="lp-field lp-cb-create-phases">
            <span>{{create_phases_label}}</span>
            <textarea name="phases" rows="5" required>{{create_phases_value}}</textarea>
            <span class="lp-field-hint">{{create_phases_help}}</span>
          </label>
        </div>
        <div class="lp-profile-form-actions">
          <button type="submit" class="lp-btn lp-btn-solid">{{create_submit}}</button>
        </div>
      </form>
    </section>
  {{/show_create_track}}

  {{^has_tracks}}
    <div class="lp-cb-empty">
      {{> local_launchpad/admin_empty}}
    </div>
  {{/has_tracks}}

  {{#has_tracks}}
    <div class="lp-cb-tabs" role="tablist" aria-label="{{heading}}">
      {{#track_tabs}}
        <a class="lp-cb-tab{{#current}} is-on{{/current}}"
           role="tab"
           href="{{url}}"
           title="{{title}}"
           data-lp-builder-tab="{{id}}"
           aria-selected="{{#current}}true{{/current}}{{^current}}false{{/current}}">
          {{label}}
        </a>
      {{/track_tabs}}
    </div>

    {{#track_panels}}
      <div class="lp-cb-panel" data-lp-builder-panel="{{id}}"{{^current}} hidden{{/current}}>
        <div class="lp-cb-workspace">
          <div class="lp-cb-main">
            {{#phases}}
              <section class="lp-cb-phase{{#shown}} is-shown{{/shown}}">
                <div class="lp-cb-phase-head">
                  <div class="lp-cb-phase-identity">
                    <span class="lp-cb-phase-n" aria-hidden="true">{{n}}</span>
                    <div>
                      <h3>{{title}}</h3>
                      <p class="lp-muted lp-sm">{{meta}}</p>
                    </div>
                  </div>
                  <div class="lp-cb-phase-actions">
                    <a class="lp-btn lp-btn-light lp-btn-sm" href="{{add_url}}">{{add_label}}</a>
                    {{#shown}}
                      <form method="post" action="{{form_action}}" class="lp-inline-form">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="toggle_section">
                        <input type="hidden" name="trackid" value="{{trackid}}">
                        <input type="hidden" name="sectionnum" value="{{sectionnum}}">
                        <input type="hidden" name="show" value="0">
                        <button type="submit" class="lp-btn lp-btn-light lp-btn-sm">{{hide_label}}</button>
                      </form>
                    {{/shown}}
                    {{^shown}}
                      {{#can_show}}
                        <form method="post" action="{{form_action}}" class="lp-inline-form">
                          <input type="hidden" name="sesskey" value="{{sesskey}}">
                          <input type="hidden" name="action" value="toggle_section">
                          <input type="hidden" name="trackid" value="{{trackid}}">
                          <input type="hidden" name="sectionnum" value="{{sectionnum}}">
                          <input type="hidden" name="show" value="1">
                          <button type="submit" class="lp-btn lp-btn-solid lp-btn-sm">{{show_label}}</button>
                        </form>
                      {{/can_show}}
                      {{^can_show}}
                        <button type="button" class="lp-btn lp-btn-solid lp-btn-sm" disabled title="{{show_blocked_title}}">{{show_label}}</button>
                      {{/can_show}}
                    {{/shown}}
                  </div>
                </div>

                {{#has_activities}}
                  <div class="lp-cb-actlist">
                    {{#activities}}
                      <div class="lp-cb-row">
                        <div class="lp-cb-row-main">
                          <span class="lp-cb-kd is-{{kind_key}}">{{kind}}</span>
                          <span class="lp-cb-row-title">{{title}}</span>
                        </div>
                        <div class="lp-cb-row-end">
                          <span class="lp-chip {{state_chip}}">{{state_label}}</span>
                          <a class="lp-btn lp-btn-light lp-btn-sm" href="{{activity_url}}">{{edit_label}}</a>
                          {{#is_draft}}
                            <form method="post" action="{{form_action}}" class="lp-inline-form">
                              <input type="hidden" name="sesskey" value="{{sesskey}}">
                              <input type="hidden" name="action" value="mark_reviewed">
                              <input type="hidden" name="trackid" value="{{trackid}}">
                              <input type="hidden" name="cmid" value="{{cmid}}">
                              <button type="submit" class="lp-btn lp-btn-ghost lp-btn-sm">{{mark_label}}</button>
                            </form>
                          {{/is_draft}}
                        </div>
                      </div>
                    {{/activities}}
                  </div>
                {{/has_activities}}
                {{^has_activities}}
                  <p class="lp-sm lp-muted lp-cb-empty-acts">{{no_acts}}</p>
                {{/has_activities}}
              </section>
            {{/phases}}

            {{#show_add_phase}}
              <section class="lp-card lp-cb-add-phase">
                <h3>{{add_phase_title}}</h3>
                <form method="post" action="{{add_phase_action}}" class="lp-cb-add-phase-form">
                  <input type="hidden" name="sesskey" value="{{add_phase_sesskey}}">
                  <input type="hidden" name="action" value="add_phase">
                  <input type="hidden" name="trackid" value="{{add_phase_trackid}}">
                  <label class="lp-field">
                    <span>{{add_phase_label}}</span>
                    <input type="text" name="phasename" required maxlength="255" placeholder="e.g. Capstone clinic">
                  </label>
                  <button type="submit" class="lp-btn lp-btn-light">{{add_phase_submit}}</button>
                </form>
              </section>
            {{/show_add_phase}}
          </div>

          <aside class="lp-cb-rail" aria-label="{{side_title}}">
            <section class="lp-cb-summary">
              <h3>{{side_title}}</h3>
              {{#side_capstone}}
                <p class="lp-sm lp-muted lp-cb-capstone">{{side_capstone}}</p>
              {{/side_capstone}}
              <dl class="lp-kv lp-sm lp-cb-kv">
                <dt>{{side_teacher_label}}</dt><dd>{{side_teacher}}</dd>
                <dt>{{side_enrolled_label}}</dt><dd>{{side_enrolled}}</dd>
                <dt>{{side_guest_label}}</dt><dd>{{side_guest}}</dd>
              </dl>
              <a class="lp-btn lp-btn-light lp-btn-sm lp-cb-preview" href="{{course_url}}">{{open_course_label}}</a>
            </section>
            <section class="lp-cb-tip">
              <div class="lp-mascot">
                {{#tip_prof_url}}
                  <img src="{{tip_prof_url}}" alt="" width="90" height="90">
                {{/tip_prof_url}}
                <div class="lp-bubble">
                  <p class="lp-sm">{{tip_body}}</p>
                </div>
              </div>
            </section>
          </aside>
        </div>
      </div>
    {{/track_panels}}
  {{/has_tracks}}
</div>
