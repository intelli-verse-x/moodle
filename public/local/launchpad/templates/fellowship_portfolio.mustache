{{!
    @template local_launchpad/fellowship_portfolio

    Fellowship portfolio — selected-track case cards (Problem → What I did → Result)
    plus fellow-written case study form (private, per active track).
}}
<div class="lp-tools-page lp-reveal" data-region="fellowship-portfolio" style="--lp-d:0">
  {{#multi_course}}
    <div class="lp-course-switch lp-home-switch lp-reveal" role="navigation" aria-label="{{#str}} fellowship_switch_courses, local_launchpad {{/str}}" style="--lp-d:0">
      {{#course_switch}}
        <a class="lp-chip{{#selected}} is-on{{/selected}}" href="{{url}}"{{#selected}} aria-current="page"{{/selected}}>{{{fullname}}}</a>
      {{/course_switch}}
    </div>
  {{/multi_course}}

  <div class="lp-port-system">
    <section class="lp-card lift lp-theme-hero lp-port-overview">
      <div class="lp-theme-hero-main">
        <div class="lp-theme-hero-title-row">
          <span class="lp-grade-progress-icon" aria-hidden="true">
            <iconify-icon icon="hugeicons:folder-01" width="22" height="22"></iconify-icon>
          </span>
          <div class="lp-card-copy">
            <div class="lp-theme-hero-heading">
              <h3>{{#str}} fellowship_nav_portfolio, local_launchpad {{/str}}</h3>
              <span class="lp-chip {{evidence_chip}}">{{evidence_status}}</span>
            </div>
            {{#selected_course_name}}
              <p class="lp-port-track">{{{selected_course_name}}}</p>
            {{/selected_course_name}}
            {{^selected_course_name}}
              <p>{{#str}} fellowship_portfolio_intro, local_launchpad {{/str}}</p>
            {{/selected_course_name}}
          </div>
        </div>
        <div class="lp-comp-hero-summary">
          <h2 class="lp-port-evidence-headline">{{evidence_headline}}</h2>
          <p class="lp-muted lp-sm">{{hero_summary}}</p>
        </div>
      </div>
      <div class="lp-theme-hero-art" aria-hidden="true">
        <span class="lp-theme-hero-orb"></span>
        <iconify-icon icon="hugeicons:folder-01" width="88" height="88"></iconify-icon>
      </div>
    </section>

    <section class="lp-card lift lp-theme-panel lp-port-stats">
      <div class="lp-card-head lp-card-head-stack">
        <div class="lp-theme-hero-title-row">
          <span class="lp-grade-progress-icon" aria-hidden="true">
            <iconify-icon icon="hugeicons:analytics-01" width="22" height="22"></iconify-icon>
          </span>
          <div class="lp-card-copy">
            <h3>{{#str}} fellowship_portfolio_stats_heading, local_launchpad {{/str}}</h3>
          </div>
        </div>
      </div>
      <dl class="lp-theme-kv lp-port-stats-kv">
        <div class="lp-theme-kv-row{{#has_evidence}} is-hot{{/has_evidence}}">
          <dt>{{#str}} fellowship_portfolio_stat_evidence, local_launchpad {{/str}}</dt>
          <dd>
            <b class="lp-num">{{count_evidence}}</b>
            {{#has_total}}<span class="lp-comp-stat-of">/ {{count_total}}</span>{{/has_total}}
          </dd>
        </div>
        <div class="lp-theme-kv-row{{#has_reviewed}} is-hot{{/has_reviewed}}">
          <dt>{{#str}} fellowship_portfolio_stat_reviewed, local_launchpad {{/str}}</dt>
          <dd><b class="lp-num">{{count_reviewed}}</b></dd>
        </div>
        <div class="lp-theme-kv-row{{#has_awaiting}} is-hot{{/has_awaiting}}">
          <dt>{{#str}} fellowship_portfolio_stat_awaiting, local_launchpad {{/str}}</dt>
          <dd><b class="lp-num">{{count_awaiting}}</b></dd>
        </div>
        {{#has_attention}}
          <div class="lp-theme-kv-row is-hot">
            <dt>{{#str}} fellowship_portfolio_stat_attention, local_launchpad {{/str}}</dt>
            <dd><b class="lp-num">{{count_attention}}</b></dd>
          </div>
        {{/has_attention}}
        <div class="lp-theme-kv-row{{#has_open}} is-hot{{/has_open}}">
          <dt>{{#str}} fellowship_portfolio_stat_open, local_launchpad {{/str}}</dt>
          <dd><b class="lp-num">{{count_open}}</b></dd>
        </div>
      </dl>
    </section>
  </div>

  {{#case_can_save}}
    <div class="lp-port-case-study">
      <form class="lp-card lift lp-port-case-form" method="post" action="{{case_form_action}}" data-region="portfolio-case-form">
        <input type="hidden" name="sesskey" value="{{case_sesskey}}">
        <input type="hidden" name="action" value="save_case_study">
        <input type="hidden" name="id" value="{{case_course_id}}">
        <div class="lp-port-case-form-head">
          <div class="lp-theme-hero-title-row">
            <span class="lp-grade-progress-icon is-sm" aria-hidden="true">
              <iconify-icon icon="hugeicons:quill-write-01" width="18" height="18"></iconify-icon>
            </span>
            <div class="lp-card-copy">
              <h3>{{#str}} fellowship_portfolio_case_heading, local_launchpad {{/str}}</h3>
              <p class="lp-sm lp-muted">{{#str}} fellowship_portfolio_case_lead, local_launchpad {{/str}}</p>
            </div>
          </div>
          {{#case_has_saved}}
            <span class="lp-chip ok" role="status">{{case_saved_label}}</span>
          {{/case_has_saved}}
        </div>

        <label class="lp-field">
          <span>{{#str}} fellowship_portfolio_case_title_label, local_launchpad {{/str}}</span>
          <input type="text" name="case_title" value="{{case_title}}" maxlength="200"
                 autocomplete="off"
                 placeholder="{{#str}} fellowship_portfolio_case_title_placeholder, local_launchpad {{/str}}">
        </label>

        <label class="lp-field">
          <span>{{#str}} fellowship_portfolio_case_body_label, local_launchpad {{/str}}</span>
          <textarea name="case_body" rows="8" maxlength="20000"
                    placeholder="{{#str}} fellowship_portfolio_case_body_placeholder, local_launchpad {{/str}}"
                    data-lp-case-body>{{case_body}}</textarea>
          <span class="lp-help lp-sm lp-muted" data-lp-case-word-help>{{case_word_help}}</span>
        </label>

        <label class="lp-check-row">
          <input type="checkbox" name="case_simulated" value="1"{{#case_simulated}} checked{{/case_simulated}}>
          <span>{{#str}} fellowship_portfolio_case_simulated_label, local_launchpad {{/str}}</span>
        </label>

        <button type="submit" class="lp-btn lp-btn-solid" style="align-self:flex-start">
          {{#str}} fellowship_portfolio_case_save, local_launchpad {{/str}}
        </button>
      </form>

      <aside class="lp-port-case-aside">
        <div class="lp-card soft lp-port-case-tip">
          <p class="lp-sm">{{case_tip}}</p>
        </div>
        <section class="lp-card lift lp-port-case-checklist" aria-label="{{#str}} fellowship_portfolio_case_checklist_heading, local_launchpad {{/str}}">
          <h3>{{#str}} fellowship_portfolio_case_checklist_heading, local_launchpad {{/str}}</h3>
          <p class="lp-sm lp-muted">{{#str}} fellowship_portfolio_case_checklist_lead, local_launchpad {{/str}}</p>
          <ul class="lp-port-case-checks">
            {{#case_checklist}}
              <li class="lp-port-case-check {{done_class}}">
                <span class="lp-port-case-check-mark" aria-hidden="true">{{#done}}✓{{/done}}</span>
                <span>{{label}}</span>
              </li>
            {{/case_checklist}}
          </ul>
        </section>
      </aside>
    </div>
  {{/case_can_save}}

  {{#has_items}}
    <section class="lp-card lift lp-port-workspace" aria-label="{{list_heading}}">
      <div class="lp-card-head lp-port-list-head">
        <div class="lp-theme-hero-title-row">
          <span class="lp-grade-progress-icon is-sm" aria-hidden="true">
            <iconify-icon icon="hugeicons:task-01" width="18" height="18"></iconify-icon>
          </span>
          <div class="lp-card-copy">
            <h3>{{list_heading}}</h3>
            <p class="lp-sm lp-muted">{{#str}} fellowship_portfolio_list_lead, local_launchpad {{/str}}</p>
          </div>
        </div>
      </div>
      <ul class="lp-port-list">
        {{#items}}
          <li class="lp-port-item lp-port-case{{#needs_attention}} is-attention{{/needs_attention}}{{#is_pending}} is-pending{{/is_pending}}">
            <div class="lp-port-case-top">
              <div class="lp-port-item-main">
                <span class="lp-grade-progress-icon is-sm" aria-hidden="true">
                  <iconify-icon icon="hugeicons:{{icon}}" width="18" height="18"></iconify-icon>
                </span>
                <div class="lp-port-item-copy">
                  <h3><a href="{{url}}">{{{name}}}</a></h3>
                </div>
              </div>
              <div class="lp-port-item-aside">
                <span class="lp-chip {{chip}}">{{status}}</span>
              </div>
            </div>
            <div class="lp-port-case-body">
              {{#has_problem_text}}
                <div class="lp-port-case-block">
                  <p class="lp-port-case-label">{{problem_label}}</p>
                  <p class="lp-port-case-text">{{problem_text}}</p>
                </div>
              {{/has_problem_text}}
              {{#has_did_text}}
                <div class="lp-port-case-block">
                  <p class="lp-port-case-label">{{did_label}}</p>
                  <p class="lp-port-case-text">{{did_text}}</p>
                </div>
              {{/has_did_text}}
              {{#has_result_text}}
                <div class="lp-port-case-block lp-port-case-result">
                  <p class="lp-port-case-label">{{result_label}}</p>
                  <p class="lp-port-case-text">{{result_text}}</p>
                  {{#has_result_feedback}}
                    <p class="lp-port-case-feedback">{{result_feedback}}</p>
                  {{/has_result_feedback}}
                </div>
              {{/has_result_text}}
            </div>
            <div class="lp-port-case-foot">
              <a class="lp-btn lp-btn-light" href="{{url}}">{{cta_label}}</a>
            </div>
          </li>
        {{/items}}
      </ul>
    </section>
  {{/has_items}}
  {{^has_items}}
    <div class="lp-empty" role="status">
      <div class="lp-empty-mark" aria-hidden="true">
        <iconify-icon icon="hugeicons:folder-01" width="26" height="26"></iconify-icon>
      </div>
      <h2>{{#str}} fellowship_portfolio_empty_title, local_launchpad {{/str}}</h2>
      <p>{{#str}} fellowship_portfolio_empty_body, local_launchpad {{/str}}</p>
      {{#track_url}}
        <a class="lp-btn lp-btn-light" href="{{track_url}}">{{#str}} fellowship_nav_track, local_launchpad {{/str}}</a>
      {{/track_url}}
    </div>
  {{/has_items}}
</div>
