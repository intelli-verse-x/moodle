{{!
    @template local_launchpad/fellowship_feedback

    Live Moodle assign feedback with status tabs.
    Empty banner (All tab) = no Moodle-visible released grade/comment yet.
}}
<div class="lp-feedback-page lp-reveal" data-region="fellowship-feedback-page" style="--lp-d:0">
{{^has_courses}}
  <div class="lp-empty" role="status">
    <div class="lp-empty-mark" aria-hidden="true">LP</div>
    <h2>{{#str}} fellowship_nav_feedback, local_launchpad {{/str}}</h2>
    <p>{{empty_message}}</p>
  </div>
{{/has_courses}}

{{#has_courses}}
  {{#multi_course}}
    <div class="lp-course-switch lp-home-switch lp-reveal" role="navigation" aria-label="{{#str}} fellowship_switch_courses, local_launchpad {{/str}}" style="--lp-d:0">
      {{#course_switch}}
        <a class="lp-chip{{#selected}} is-on{{/selected}}" href="{{url}}"{{#selected}} aria-current="page"{{/selected}}>{{{fullname}}}</a>
      {{/course_switch}}
    </div>
  {{/multi_course}}

  {{^has_assigns}}
    <div class="lp-empty" role="status">
      <div class="lp-empty-mark" aria-hidden="true">·</div>
      <h2>{{#str}} fellowship_feedback_no_assigns_title, local_launchpad {{/str}}</h2>
      <p>{{#str}} fellowship_feedback_no_assigns_body, local_launchpad {{/str}}</p>
      <a class="lp-btn lp-btn-light" href="{{track_url}}">{{#str}} fellowship_nav_track, local_launchpad {{/str}}</a>
    </div>
  {{/has_assigns}}

  {{#has_assigns}}
    {{#show_tabs}}
      <div class="lp-feedback-tabs-wrap">
        <div class="lp-tabs lp-tabs-block lp-feedback-tabs" role="tablist" aria-label="{{#str}} fellowship_nav_feedback, local_launchpad {{/str}}">
          <a class="lp-tab{{#ftab_all}} is-on{{/ftab_all}}"
             role="tab"
             href="{{tab_all_url}}"
             aria-selected="{{#ftab_all}}true{{/ftab_all}}{{^ftab_all}}false{{/ftab_all}}">
            {{#str}} fellowship_feedback_tab_all, local_launchpad {{/str}}
            <span class="lp-tab-count">{{all_count}}</span>
          </a>
          <a class="lp-tab{{#ftab_attention}} is-on{{/ftab_attention}}"
             role="tab"
             href="{{tab_attention_url}}"
             aria-selected="{{#ftab_attention}}true{{/ftab_attention}}{{^ftab_attention}}false{{/ftab_attention}}">
            {{#str}} fellowship_feedback_tab_attention, local_launchpad {{/str}}
            <span class="lp-tab-count">{{attention_tab_count}}</span>
          </a>
          <a class="lp-tab{{#ftab_reviewed}} is-on{{/ftab_reviewed}}"
             role="tab"
             href="{{tab_reviewed_url}}"
             aria-selected="{{#ftab_reviewed}}true{{/ftab_reviewed}}{{^ftab_reviewed}}false{{/ftab_reviewed}}">
            {{#str}} fellowship_feedback_tab_reviewed, local_launchpad {{/str}}
            <span class="lp-tab-count">{{reviewed_count}}</span>
          </a>
          <a class="lp-tab{{#ftab_pending}} is-on{{/ftab_pending}}"
             role="tab"
             href="{{tab_pending_url}}"
             aria-selected="{{#ftab_pending}}true{{/ftab_pending}}{{^ftab_pending}}false{{/ftab_pending}}">
            {{#str}} fellowship_feedback_tab_pending, local_launchpad {{/str}}
            <span class="lp-tab-count">{{pending_count}}</span>
          </a>
          <a class="lp-tab{{#ftab_not_submitted}} is-on{{/ftab_not_submitted}}"
             role="tab"
             href="{{tab_not_submitted_url}}"
             aria-selected="{{#ftab_not_submitted}}true{{/ftab_not_submitted}}{{^ftab_not_submitted}}false{{/ftab_not_submitted}}">
            {{#str}} fellowship_feedback_tab_not_submitted, local_launchpad {{/str}}
            <span class="lp-tab-count">{{not_submitted_count}}</span>
          </a>
        </div>
      </div>
    {{/show_tabs}}

    {{#show_empty_released}}
      <section class="lp-feedback-empty" role="status">
        <div class="lp-feedback-empty-art" aria-hidden="true">
          {{#empty_avatar_url}}
            <span class="lp-feedback-empty-glow"></span>
            <img class="lp-feedback-empty-img" src="{{empty_avatar_url}}" alt="" width="280" height="280" decoding="async">
          {{/empty_avatar_url}}
          {{^empty_avatar_url}}
            <div class="lp-empty-mark">·</div>
          {{/empty_avatar_url}}
        </div>
        <div class="lp-feedback-empty-copy">
          <span class="lp-feedback-tag">
            <iconify-icon icon="hugeicons:comment-01" width="16" height="16" aria-hidden="true"></iconify-icon>
            {{#str}} fellowship_feedback_tag, local_launchpad {{/str}}
          </span>
          <h2 class="lp-feedback-empty-title">
            {{empty_title_lead}}
            <span>{{empty_title_accent}}</span>
            {{empty_title_trail}}
          </h2>
          <p>{{empty_body}}</p>
          {{#has_empty_cta}}
            <a class="lp-btn lp-btn-solid lp-feedback-empty-cta" href="{{empty_cta_url}}">
              <iconify-icon icon="hugeicons:link-square-02" width="18" height="18" aria-hidden="true"></iconify-icon>
              {{empty_cta_label}}
              <iconify-icon icon="hugeicons:arrow-right-02" width="16" height="16" aria-hidden="true"></iconify-icon>
            </a>
          {{/has_empty_cta}}
        </div>
      </section>
    {{/show_empty_released}}

    {{#show_filter_empty}}
      <div class="lp-empty lp-empty-inline" role="status">
        <h2>{{#str}} fellowship_feedback_filter_empty_title, local_launchpad {{/str}}</h2>
        <p>{{#str}} fellowship_feedback_filter_empty_body, local_launchpad {{/str}}</p>
        <div class="lp-empty-actions">
          <a class="lp-btn lp-btn-light" href="{{tab_all_url}}">{{#str}} fellowship_feedback_tab_all, local_launchpad {{/str}}</a>
        </div>
      </div>
    {{/show_filter_empty}}

    {{#has_attention_items}}
      <section class="lp-feedback-block" aria-label="{{#str}} fellowship_feedback_section_attention, local_launchpad {{/str}}">
        {{#ftab_all}}
          <h2 class="lp-feedback-section">{{#str}} fellowship_feedback_section_attention, local_launchpad {{/str}}</h2>
        {{/ftab_all}}
        <div class="lp-feedback-list">
          {{#attention_items}}
            {{> local_launchpad/fellowship_feedback_card}}
          {{/attention_items}}
        </div>
      </section>
    {{/has_attention_items}}

    {{#has_reviewed_items}}
      <section class="lp-feedback-block" aria-label="{{#str}} fellowship_feedback_section_released, local_launchpad {{/str}}">
        {{#ftab_all}}
          <h2 class="lp-feedback-section">{{#str}} fellowship_feedback_section_released, local_launchpad {{/str}}</h2>
        {{/ftab_all}}
        <div class="lp-feedback-list">
          {{#reviewed_items}}
            {{> local_launchpad/fellowship_feedback_card}}
          {{/reviewed_items}}
        </div>
      </section>
    {{/has_reviewed_items}}

    {{#has_pending_items}}
      <section class="lp-feedback-block" aria-label="{{#str}} fellowship_feedback_section_pending, local_launchpad {{/str}}">
        {{#ftab_all}}
          <h2 class="lp-feedback-section">{{#str}} fellowship_feedback_section_pending, local_launchpad {{/str}}</h2>
        {{/ftab_all}}
        <div class="lp-feedback-list">
          {{#pending_items}}
            {{> local_launchpad/fellowship_feedback_card}}
          {{/pending_items}}
        </div>
      </section>
    {{/has_pending_items}}

    {{#has_not_submitted_items}}
      <section class="lp-feedback-block" aria-label="{{#str}} fellowship_feedback_section_not_submitted, local_launchpad {{/str}}">
        {{#ftab_all}}
          <h2 class="lp-feedback-section">{{#str}} fellowship_feedback_section_not_submitted, local_launchpad {{/str}}</h2>
        {{/ftab_all}}
        <div class="lp-feedback-list">
          {{#not_submitted_items}}
            {{> local_launchpad/fellowship_feedback_card}}
          {{/not_submitted_items}}
        </div>
      </section>
    {{/has_not_submitted_items}}

    <p class="lp-feedback-native-note">{{#str}} fellowship_feedback_native_note, local_launchpad {{/str}}</p>
  {{/has_assigns}}
{{/has_courses}}
</div>
