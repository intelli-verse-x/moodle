{{!
    @template local_launchpad/mentor_shell

    Mentor authenticated shell (side nav + main). No XP / orbit — review inbox only.
}}
<a class="lp-skip" href="#lp-main">{{#str}} mentor_skip_to_content, local_launchpad {{/str}}</a>
<div class="lp-shell" data-region="{{data_region}}" id="lp-shell">
  <div class="lp-scrim" data-lp-nav-close hidden></div>
  <nav class="lp-side" id="lp-side" aria-label="{{#str}} mentor_nav_aria, local_launchpad {{/str}}">
    <a class="lp-logo" href="{{home_url}}">
      <img class="lp-logo-img" src="{{assets}}/logo-on-dark.png" alt="ToBa Learn" width="106" height="40">
    </a>
    <div class="lp-role">{{role_label}}</div>
    {{#nav_groups}}
      <div class="lp-nl">{{group}}</div>
      {{#items}}
        <a class="lp-nav{{#current}} is-current{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>
          {{#icon_svg}}{{{icon_svg}}}{{/icon_svg}}
          <span>{{label}}</span>
          {{#has_badge}}<span class="lp-nav-badge">{{badge}}</span>{{/has_badge}}
        </a>
      {{/items}}
    {{/nav_groups}}
    <div class="lp-side-foot">
      {{#profile_menu_side}}
        {{> local_launchpad/profile_menu }}
      {{/profile_menu_side}}
    </div>
  </nav>
  <div class="lp-main-wrap">
    <header class="lp-topbar">
      <div class="lp-topbar-primary">
        <div class="lp-topbar-start">
          <button type="button" class="lp-menu-btn" data-lp-nav-toggle aria-expanded="false" aria-controls="lp-side" aria-label="{{#str}} fellowship_menu, local_launchpad {{/str}}">
            <iconify-icon icon="hugeicons:menu-01" width="20" height="20" aria-hidden="true"></iconify-icon>
            <span class="lp-menu-btn-label">{{#str}} fellowship_menu, local_launchpad {{/str}}</span>
          </button>
          <a class="lp-topbar-brand" href="{{home_url}}" title="ToBa Learn">
            <img class="lp-topbar-brand-img" src="{{assets}}/logo.webp" alt="ToBa Learn" width="120" height="32">
          </a>
          <h1 class="lp-page-title">{{pagetitle}}</h1>
        </div>
        <div class="lp-topbar-actions">
          {{> local_launchpad/notification_dropdown }}
          {{> local_launchpad/profile_menu }}
        </div>
      </div>
      {{> local_launchpad/mobile_topbar_context }}
    </header>
    <main class="lp-main" id="lp-main" tabindex="-1">
      <div class="lp-mobile-pagehead">
        <h1 class="lp-mobile-page-title">{{pagetitle}}</h1>
      </div>
      <div class="lp-inner">{{{content}}}</div>
    </main>
  </div>
</div>
{{> local_launchpad/portal_mismatch_modal}}
