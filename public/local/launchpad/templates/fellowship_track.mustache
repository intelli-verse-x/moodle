{{!
    @template local_launchpad/fellowship_track

    My track — Employer course-detail chrome over Fellowship gates + Moodle activities.
}}
<div class="lp-track-page lp-reveal" data-region="fellowship-track" style="--lp-d:0">
{{#has_crumbs}}
  <nav class="lp-crumbs" aria-label="{{#str}} fellowship_breadcrumb, local_launchpad {{/str}}">
    {{#crumbs}}
      {{#url}}<a href="{{url}}">{{label}}</a><span aria-hidden="true">/</span>{{/url}}
      {{^url}}<span aria-current="page">{{label}}</span>{{/url}}
    {{/crumbs}}
  </nav>
{{/has_crumbs}}

{{#multi_course}}
  <div class="lp-course-switch" role="navigation" aria-label="{{#str}} fellowship_your_courses, local_launchpad {{/str}}">
    {{#courses}}
      <a class="lp-chip{{#selected}} is-on{{/selected}}" href="{{url}}">{{{fullname}}}</a>
    {{/courses}}
  </div>
{{/multi_course}}

<section class="lp-course-hero">
  <div class="lp-course-hero-main">
    <div class="lp-mycourse-chips">
      <span class="lp-chip warn">{{course_badge}}</span>
      <span class="lp-chip {{course_statustype}}">{{course_status}}</span>
    </div>
    <h2 class="lp-course-hero-title">{{{course_name}}}</h2>
    <p class="lp-muted lp-course-hero-lead">{{{course_lead}}}</p>
    {{#has_next}}
      {{#next}}
        <p class="lp-course-hero-next">
          <span class="lp-muted">{{#str}} fellowship_next_activity, local_launchpad {{/str}}</span>
          <a class="lp-link" href="{{url}}">{{{name}}}</a>
        </p>
      {{/next}}
    {{/has_next}}
    <div class="lp-course-hero-actions">
      {{#has_next}}
        {{#next}}
          <a class="lp-btn lp-btn-solid" href="{{url}}">
            {{#str}} fellowship_cta_resume, local_launchpad {{/str}}
            <iconify-icon icon="hugeicons:arrow-right-02" width="16" height="16" aria-hidden="true"></iconify-icon>
          </a>
        {{/next}}
      {{/has_next}}
      {{#has_first_section}}
        <a class="lp-btn lp-btn-light" href="#{{first_section_anchor}}">{{#str}} fellowship_track_phases_heading, local_launchpad {{/str}}</a>
      {{/has_first_section}}
      <a class="lp-btn lp-btn-light" href="{{moodle_course_url}}">{{#str}} fellowship_open_moodle_course, local_launchpad {{/str}}</a>
    </div>
  </div>
  {{#hasprogress}}
    <div class="lp-course-hero-ring" aria-label="{{activitypct}}%">
      <b>{{activitypct}}%</b>
      <span>{{activitydone}} / {{activitytotal}}</span>
    </div>
  {{/hasprogress}}
</section>

{{#journey.has_gates}}
  <section class="lp-card lift lp-journey-card lp-home-block">
    <div class="lp-card-head lp-card-head-stack">
      <div>
        <h3 class="lp-journey-title">{{#str}} fellowship_your_journey, local_launchpad {{/str}}</h3>
        <p class="lp-card-sub">{{#str}} fellowship_journey_help_short, local_launchpad {{/str}}</p>
      </div>
    </div>
    {{> local_launchpad/fellowship_journey}}
  </section>
{{/journey.has_gates}}

<div class="lp-grid-2 lp-track-grid">
  <div class="lp-stack">
    <section class="lp-course-outline" aria-label="{{#str}} fellowship_track_phases_heading, local_launchpad {{/str}}">
      <div class="lp-phases-head">
        <h3>{{#str}} fellowship_track_phases_heading, local_launchpad {{/str}}</h3>
        <p class="lp-phases-lead">{{#str}} fellowship_track_phases_help, local_launchpad {{/str}}</p>
      </div>
      {{#has_track_phases}}
        <ol class="lp-outline">
          {{#track_phases}}
            <li class="lp-outline-step{{#is_current}} is-current{{/is_current}}{{^released}} is-locked{{/released}}">
              <div class="lp-outline-rail" aria-hidden="true">
                <span class="lp-outline-dot">{{index}}</span>
              </div>
              <details class="lp-phase-acc{{^released}} is-off{{/released}}" id="{{anchor}}"{{#is_open}} open{{/is_open}}>
                <summary>
                  <span class="lp-phase-ico tone-{{icon_tone}}" aria-hidden="true">
                    <iconify-icon icon="hugeicons:{{icon}}" width="20" height="20"></iconify-icon>
                  </span>
                  <div class="lp-phase-sum">
                    <h3>{{name}}</h3>
                    <span class="lp-sm lp-muted">{{blurb}}</span>
                  </div>
                  {{#released}}
                    {{#has_chip_class}}
                      <span class="lp-chip {{chip}}">{{status}}</span>
                    {{/has_chip_class}}
                    {{^has_chip_class}}
                      <span class="lp-chip">{{status}}</span>
                    {{/has_chip_class}}
                  {{/released}}
                  {{^released}}
                    <span class="lp-chip line has-ico">
                      <iconify-icon icon="hugeicons:square-lock-02" width="12" height="12" aria-hidden="true"></iconify-icon>
                      {{#str}} fellowship_track_not_released_short, local_launchpad {{/str}}
                    </span>
                  {{/released}}
                  <iconify-icon class="lp-phase-chev" icon="hugeicons:arrow-up-01" width="18" height="18" aria-hidden="true"></iconify-icon>
                </summary>
                <div class="lp-phase-body">
                  {{#released}}
                    {{#has_activities}}
                      <ul class="lp-act-cards">
                        {{#activities}}
                          <li>
                            <a class="lp-act-card{{#complete}} is-done{{/complete}}" href="{{url}}">
                              <span class="lp-act-k tone-{{tone}}">{{meta}}</span>
                              <span class="lp-act-card-row">
                                <span class="lp-act-ico tone-{{tone}}" aria-hidden="true">
                                  <iconify-icon icon="hugeicons:{{icon}}" width="18" height="18"></iconify-icon>
                                </span>
                                <span class="lp-act-card-main">
                                  <b>{{{name}}}</b>
                                </span>
                                <span class="lp-chip {{statustone}}">{{status_label}}</span>
                                <iconify-icon class="lp-act-chev" icon="hugeicons:arrow-right-01" width="18" height="18" aria-hidden="true"></iconify-icon>
                              </span>
                            </a>
                          </li>
                        {{/activities}}
                      </ul>
                    {{/has_activities}}
                    {{^has_activities}}
                      <p class="lp-sm lp-muted">{{#str}} fellowship_no_activities, local_launchpad {{/str}}</p>
                    {{/has_activities}}
                  {{/released}}
                  {{^released}}
                    <p class="lp-sm lp-muted">{{locked_note}}</p>
                  {{/released}}
                </div>
              </details>
            </li>
          {{/track_phases}}
        </ol>
      {{/has_track_phases}}
      {{^has_track_phases}}
        <div class="lp-empty" role="status">
          <div class="lp-empty-mark" aria-hidden="true">
            <iconify-icon icon="hugeicons:layers-01" width="26" height="26"></iconify-icon>
          </div>
          <h2>{{#str}} fellowship_no_activities, local_launchpad {{/str}}</h2>
        </div>
      {{/has_track_phases}}
      <p class="lp-note">{{#str}} fellowship_native_activities_note, local_launchpad {{/str}}</p>
    </section>
  </div>

  <aside class="lp-stack lp-stack-lg lp-track-aside">
    <section class="lp-card lift lp-home-block lp-stack">
      <div class="lp-card-head lp-card-head-stack">
        <div>
          <h3>{{#str}} fellowship_track_capstone, local_launchpad {{/str}}</h3>
          <p class="lp-card-sub">{{#str}} fellowship_track_capstone_help, local_launchpad {{/str}}</p>
        </div>
      </div>
      <p class="lp-sm">{{{capstone_body}}}</p>
    </section>

    <section class="lp-card lift lp-home-block">
      <div class="lp-card-head lp-card-head-stack">
        <div>
          <h3>{{#str}} fellowship_track_meta_heading, local_launchpad {{/str}}</h3>
        </div>
      </div>
      <dl class="lp-kv">
        <dt>{{#str}} fellowship_track_meta_prereq, local_launchpad {{/str}}</dt>
        <dd>{{{prerequisite}}}</dd>
        <dt>{{#str}} fellowship_track_meta_device, local_launchpad {{/str}}</dt>
        <dd>{{{device}}}</dd>
        <dt>{{#str}} fellowship_track_meta_tools, local_launchpad {{/str}}</dt>
        <dd>{{{tools}}}</dd>
        <dt>{{#str}} fellowship_track_meta_mentor, local_launchpad {{/str}}</dt>
        <dd>
          {{#has_mentors}}
            <ul class="lp-mentor-contact-list">
              {{#mentors}}
                <li class="lp-mentor-contact">
                  <span>{{{name}}}</span>
                  {{#can_message}}
                    <a class="lp-link-sm" href="{{message_url}}">{{#str}} fellowship_message_mentor, local_launchpad {{/str}}</a>
                  {{/can_message}}
                </li>
              {{/mentors}}
            </ul>
          {{/has_mentors}}
          {{^has_mentors}}
            {{{mentor}}}
          {{/has_mentors}}
        </dd>
      </dl>
    </section>

    <section class="lp-card lift lp-home-block lp-stack">
      <div class="lp-card-head lp-card-head-stack">
        <div>
          <h3>{{#str}} fellowship_track_how_completion, local_launchpad {{/str}}</h3>
          <p class="lp-card-sub">{{#str}} fellowship_track_how_completion_lead, local_launchpad {{/str}}</p>
        </div>
      </div>
      {{#weight_rows}}
        <div class="lp-weight-row">
          <div class="lp-row-sb lp-sm">
            <span>{{name}}</span>
            <b class="lp-num">{{weight_label}}</b>
          </div>
          <div class="lp-bar lp-bar-thin" aria-hidden="true"><i style="width:{{bar_pct}}%"></i></div>
        </div>
      {{/weight_rows}}
    </section>
  </aside>
</div>
</div>
