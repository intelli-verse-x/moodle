{{!
    @template local_launchpad/fellowship_shell

    Fellowship authenticated shell: skip → sidebar → topbar → main → orbit.
    Mobile: Stitch two-tier topbar (brand row + track/phase context) — Fellow first.
}}
<a class="lp-skip" href="#lp-main">{{#str}} fellowship_skip_to_content, local_launchpad {{/str}}</a>
<div class="lp-shell" data-region="{{data_region}}" id="lp-shell">
  <div class="lp-scrim" data-lp-nav-close hidden></div>
  {{> local_launchpad/fellowship_nav }}

  <div class="lp-main-wrap">
    <header class="lp-topbar">
      <div class="lp-topbar-primary">
        <div class="lp-topbar-start">
          <button type="button" class="lp-menu-btn" data-lp-nav-toggle aria-expanded="false" aria-controls="lp-side" aria-label="{{#str}} fellowship_menu, local_launchpad {{/str}}">
            <iconify-icon icon="hugeicons:menu-01" width="20" height="20" aria-hidden="true"></iconify-icon>
            <span class="lp-menu-btn-label">{{#str}} fellowship_menu, local_launchpad {{/str}}</span>
          </button>
          <a class="lp-topbar-brand" href="{{home_url}}" title="ToBa Learn">
            <img class="lp-topbar-brand-img" src="{{assets}}/logo.webp" alt="ToBa Learn" width="120" height="32">
          </a>
          <div class="lp-greet">
            <h1 class="lp-page-title">{{#is_home}}{{greeting}}{{/is_home}}{{^is_home}}{{pagetitle}}{{/is_home}}</h1>
            <p class="lp-greet-sub">{{portallabel}}{{#active_course_label}} · <span class="lp-greet-track">{{{active_course_label}}}</span>{{/active_course_label}}</p>
          </div>
        </div>
        <div class="lp-topbar-actions">
          {{#has_courses}}
            <a class="lp-xp-chip" href="{{achievements_url}}" title="{{#str}} fellowship_xp_title, local_launchpad {{/str}}">
              <iconify-icon icon="hugeicons:star" width="16" height="16" aria-hidden="true"></iconify-icon>
              <b>{{xp_total}}</b> <span>XP</span>
            </a>
          {{/has_courses}}
          {{> local_launchpad/notification_dropdown }}
          {{> local_launchpad/profile_menu }}
        </div>
      </div>
      {{> local_launchpad/mobile_topbar_context }}
    </header>
    <main class="lp-main" id="lp-main" tabindex="-1">
      <div class="lp-mobile-pagehead">
        <h1 class="lp-mobile-page-title">{{#is_home}}{{greeting}}{{/is_home}}{{^is_home}}{{pagetitle}}{{/is_home}}</h1>
      </div>
      <div class="lp-inner">{{{content}}}</div>
    </main>
  </div>
</div>
{{> local_launchpad/portal_mismatch_modal}}
{{#bot_url}}
<div class="lp-orbit" id="lp-orbit" data-lp-orbit>
  <div class="lp-orbit-say{{^orbit_tip}} is-hide{{/orbit_tip}}" id="lp-orbit-say" role="status">
    <span class="lp-orbit-say-text">{{{orbit_tip}}}</span>
    <button type="button" class="lp-orbit-say-x" data-lp-orbit-dismiss aria-label="{{#str}} fellowship_orbit_dismiss, local_launchpad {{/str}}">×</button>
  </div>
  <button type="button" class="lp-orbit-botbtn" data-lp-orbit-hop aria-label="{{#str}} fellowship_orbit_aria, local_launchpad {{/str}}">
    <img class="lp-orbit-bot" src="{{bot_url}}" alt="">
  </button>
</div>
<button type="button" class="lp-orbit-hide" data-lp-orbit-hide>{{#str}} fellowship_orbit_hide, local_launchpad {{/str}}</button>
{{/bot_url}}
