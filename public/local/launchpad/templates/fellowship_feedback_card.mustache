{{!
    @template local_launchpad/fellowship_feedback_card
}}
<section class="lp-card lift lp-feedback-card{{#needs_attention}} is-attention{{/needs_attention}}">
  <div class="lp-feedback-card-main">
    <span class="lp-feedback-card-ico" aria-hidden="true">
      <iconify-icon icon="hugeicons:task-01" width="22" height="22"></iconify-icon>
    </span>
    <div class="lp-feedback-card-copy">
      <span class="lp-feedback-card-course">{{{course_name}}}</span>
      <h3>{{{name}}}</h3>
      <p>{{summary}}</p>
      {{#has_attempt}}
        <p class="lp-feedback-card-meta">{{#str}} fellowship_feedback_attempt, local_launchpad {{/str}} {{attempt}}{{#submitted_at}} · {{submitted_at}}{{/submitted_at}}</p>
      {{/has_attempt}}
    </div>
    <div class="lp-feedback-card-side">
      <span class="lp-feedback-status {{chip}}">
        <i aria-hidden="true"></i>
        {{status_label}}
      </span>
      <a class="lp-feedback-cta" href="{{url}}">
        {{cta_label}}
        <iconify-icon icon="hugeicons:arrow-right-02" width="16" height="16" aria-hidden="true"></iconify-icon>
      </a>
    </div>
  </div>
  {{#has_grade}}
    <div class="lp-feedback-grade">
      <b>{{grade_display}}</b>
      {{#graded_at}}<span class="lp-muted lp-sm">{{#str}} fellowship_feedback_released, local_launchpad {{/str}} {{graded_at}}</span>{{/graded_at}}
    </div>
  {{/has_grade}}
  {{#has_next_step}}
    <div class="lp-feedback-nextstep" role="status">
      <span class="lp-feedback-nextstep-label">{{#str}} fellowship_feedback_nextstep_label, local_launchpad {{/str}}</span>
      <p class="lp-feedback-nextstep-text">{{next_step}}</p>
    </div>
  {{/has_next_step}}
  {{#has_comment}}
    <blockquote class="lp-quote">{{{comment_html}}}</blockquote>
  {{/has_comment}}
  {{#has_moodle_feedback_note}}
    <p class="lp-feedback-plugin-note">{{moodle_feedback_note}}</p>
  {{/has_moodle_feedback_note}}
</section>
