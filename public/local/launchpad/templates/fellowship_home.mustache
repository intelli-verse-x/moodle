{{!
    @template local_launchpad/fellowship_home
}}
{{^has_courses}}
  <div class="lp-empty" role="status">
    <div class="lp-empty-mark" aria-hidden="true">LP</div>
    <h2>{{welcome_heading}}</h2>
    <p>{{empty_message}}</p>
  </div>
{{/has_courses}}
{{#has_courses}}
  <div class="lp-hero">
    <span class="lp-eyebrow">{{#str}} fellowship_role_label, local_launchpad {{/str}}</span>
    <h2>{{welcome_back}}</h2>
    <p class="lp-hero-lead">{{#str}} fellowship_home_lead, local_launchpad {{/str}}</p>
    {{#has_next}}
      <div class="lp-quest">
        <div>
          <span class="lp-eyebrow">{{#str}} fellowship_next_activity, local_launchpad {{/str}}</span>
          <p class="lp-quest-title">{{{next.name}}}</p>
          <p class="lp-muted">{{next.modname_display}}{{#selected_course_name}} · {{{selected_course_name}}}{{/selected_course_name}}</p>
        </div>
        <a class="lp-btn lp-btn-primary" href="{{next.url}}">{{#str}} fellowship_open_activity, local_launchpad {{/str}}</a>
      </div>
    {{/has_next}}
    {{^has_next}}
      {{#has_percent}}
        <p class="lp-muted">{{#str}} fellowship_all_tracked_done, local_launchpad {{/str}}</p>
      {{/has_percent}}
    {{/has_next}}
  </div>

  {{#journey.has_gates}}
    <section class="lp-card lift lp-journey-card">
      <div class="lp-card-head">
        <h2 class="lp-journey-title">{{#str}} fellowship_your_journey, local_launchpad {{/str}}</h2>
        <a class="lp-link" href="{{track_url}}">{{#str}} fellowship_open_track, local_launchpad {{/str}} →</a>
      </div>
      <div class="lp-journey compact" data-lp-journey>
        <div class="lp-journey-in">
          <svg viewBox="0 0 1000 {{journey.view_h}}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="{{#str}} fellowship_journey_aria, local_launchpad {{/str}}">
            <path d="{{journey.path_d}}" fill="none" stroke="var(--lp-blue-soft)" stroke-width="14" stroke-linecap="round"/>
            <path class="lp-journey-progress" d="{{journey.path_d}}" fill="none" stroke="var(--lp-blue)" stroke-width="14" stroke-linecap="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" data-to="{{journey.dash_offset}}"/>
            <path d="{{journey.path_d}}" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="2 14" stroke-linecap="round" opacity=".7"/>
            {{#journey.gates}}
              <g class="lp-jn {{status}}" transform="translate({{cx}},{{cy}})">
                <title>{{name}}</title>
                <circle r="24" class="ring"/>
                <circle r="17" class="core"/>
                <text y="6" text-anchor="middle">{{mark}}</text>
                <text class="lb" y="44" text-anchor="middle">{{short}}</text>
              </g>
            {{/journey.gates}}
          </svg>
          {{#bot_url}}
            <img class="lp-jbot" src="{{bot_url}}" alt="" style="left:{{journey.bot_left}};top:{{journey.bot_top}}">
          {{/bot_url}}
        </div>
      </div>
    </section>
  {{/journey.has_gates}}

  <div class="lp-grid-2">
    <section class="lp-card lift">
      <div class="lp-card-head">
        <h3>{{#str}} fellowship_your_courses, local_launchpad {{/str}}</h3>
        <a class="lp-link" href="{{track_url}}">{{#str}} fellowship_nav_track, local_launchpad {{/str}} →</a>
      </div>
      <ul class="lp-course-list">
        {{#courses}}
          <li>
            <a href="{{url}}">
              <b>{{{fullname}}}</b>
              <span class="lp-muted">{{idnumber}}</span>
            </a>
            <a class="lp-link-sm" href="{{moodle_url}}">{{#str}} fellowship_open_moodle_course, local_launchpad {{/str}}</a>
          </li>
        {{/courses}}
      </ul>
    </section>
    <section class="lp-card lift">
      <div class="lp-card-head">
        <h3>{{#str}} fellowship_nav_progress, local_launchpad {{/str}}</h3>
        <a class="lp-link" href="{{progress_url}}">{{#str}} fellowship_view_progress, local_launchpad {{/str}} →</a>
      </div>
      {{#has_percent}}
        <div class="lp-progress-block">
          <div class="lp-progress-meta">
            <b>{{percent}}%</b>
            <span class="lp-muted">{{completed}} / {{trackable}}</span>
          </div>
          <div class="lp-bar" aria-hidden="true"><i style="width:{{percent}}%"></i></div>
          <p class="lp-xs lp-muted">{{#str}} fellowship_progress_from_completion, local_launchpad {{/str}}</p>
        </div>
      {{/has_percent}}
      {{^has_percent}}
        <p class="lp-muted">{{#str}} fellowship_progress_not_tracked, local_launchpad {{/str}}</p>
      {{/has_percent}}
    </section>
  </div>
{{/has_courses}}
