{{!
    @template local_launchpad/fellowship_calendar

    LaunchPad calendar: Month | Day | Upcoming + filters + personal/course CRUD.
}}
<div class="lp-cal-root"
  data-lp-cal-root
  data-personal-ajax="{{personal_ajax_url}}"
  data-reschedule-ajax="{{reschedule_ajax_url}}"
  data-sesskey="{{sesskey}}"
  data-portal="{{portal}}"
  data-default-scope="{{default_scope}}"
  data-str-edit-title="{{#str}} fellowship_calendar_edit_event, local_launchpad {{/str}}"
  data-str-add-title="{{#str}} fellowship_calendar_add_event, local_launchpad {{/str}}"
  data-str-saved="{{#str}} fellowship_calendar_saved, local_launchpad {{/str}}"
  data-str-deleted="{{#str}} fellowship_calendar_deleted, local_launchpad {{/str}}"
  data-str-delete-confirm="{{#str}} fellowship_calendar_delete_confirm, local_launchpad {{/str}}"
  data-str-network="{{#str}} fellowship_calendar_err_network, local_launchpad {{/str}}"
  data-str-course-required="{{#str}} fellowship_calendar_err_course, local_launchpad {{/str}}">

<div class="lp-cal-toolbar">
  {{#can_add_event}}
    <button type="button" class="lp-btn lp-btn-solid" data-lp-cal-add>
      <iconify-icon icon="hugeicons:add-01" width="18" height="18" aria-hidden="true"></iconify-icon>
      {{#str}} fellowship_calendar_add_event, local_launchpad {{/str}}
    </button>
  {{/can_add_event}}
  <a class="lp-btn lp-btn-light lp-cal-export" href="{{export_url}}">
    <iconify-icon icon="hugeicons:download-04" width="18" height="18" aria-hidden="true"></iconify-icon>
    {{#str}} fellowship_calendar_export_ical, local_launchpad {{/str}}
  </a>
</div>

<p class="lp-cal-flash" data-lp-cal-flash hidden role="status"></p>

<div class="lp-cal-controls">
  <div class="lp-cal-tabs" role="tablist" aria-label="{{#str}} fellowship_calendar_view_aria, local_launchpad {{/str}}">
    <a class="lp-cal-tab{{#mode_month}} is-on{{/mode_month}}" href="{{month_toggle_url}}" role="tab" aria-selected="{{#mode_month}}true{{/mode_month}}{{^mode_month}}false{{/mode_month}}">
      {{#str}} fellowship_calendar_tab_month, local_launchpad {{/str}}
    </a>
    <a class="lp-cal-tab{{#mode_week}} is-on{{/mode_week}}" href="{{week_toggle_url}}" role="tab" aria-selected="{{#mode_week}}true{{/mode_week}}{{^mode_week}}false{{/mode_week}}">
      {{#str}} fellowship_calendar_tab_week, local_launchpad {{/str}}
    </a>
    <a class="lp-cal-tab{{#mode_day}} is-on{{/mode_day}}" href="{{day_toggle_url}}" role="tab" aria-selected="{{#mode_day}}true{{/mode_day}}{{^mode_day}}false{{/mode_day}}">
      {{#str}} fellowship_calendar_tab_day, local_launchpad {{/str}}
    </a>
    <a class="lp-cal-tab{{#mode_upcoming}} is-on{{/mode_upcoming}}" href="{{upcoming_toggle_url}}" role="tab" aria-selected="{{#mode_upcoming}}true{{/mode_upcoming}}{{^mode_upcoming}}false{{/mode_upcoming}}">
      {{#str}} fellowship_calendar_tab_upcoming, local_launchpad {{/str}}
    </a>
  </div>
  <label class="lp-cal-filters">
    <span class="lp-cal-filters-ico" aria-hidden="true">
      <iconify-icon icon="hugeicons:filter" width="16" height="16"></iconify-icon>
    </span>
    <select class="lp-cal-filter-select" data-lp-cal-filter aria-label="{{#str}} fellowship_calendar_filter_aria, local_launchpad {{/str}}">
      <option value="all" data-url="{{filter_all_url}}"{{#filter_all}} selected{{/filter_all}}>{{#str}} fellowship_calendar_filter_all, local_launchpad {{/str}}</option>
      <option value="course" data-url="{{filter_course_url}}"{{#filter_course}} selected{{/filter_course}}>{{#str}} fellowship_calendar_filter_course, local_launchpad {{/str}}</option>
      <option value="personal" data-url="{{filter_personal_url}}"{{#filter_personal}} selected{{/filter_personal}}>{{#str}} fellowship_calendar_filter_personal, local_launchpad {{/str}}</option>
    </select>
  </label>
</div>

{{#mode_month}}
  {{> local_launchpad/fellowship_calendar_month}}
{{/mode_month}}

{{#mode_week}}
  {{> local_launchpad/fellowship_calendar_week}}
{{/mode_week}}

{{#mode_day}}
  <div class="lp-cal-dayview lp-cal-panel" data-lp-cal-dayview>
    <div class="lp-cal-month-head">
      <div class="lp-cal-month-nav">
        <a class="lp-btn lp-btn-light lp-btn-sm lp-cal-nav-btn" href="{{prev_day_url}}" aria-label="{{#str}} fellowship_calendar_prev_day, local_launchpad {{/str}}">‹</a>
        <h3 class="lp-cal-month-label">{{day_label}}</h3>
        <a class="lp-btn lp-btn-light lp-btn-sm lp-cal-nav-btn" href="{{next_day_url}}" aria-label="{{#str}} fellowship_calendar_next_day, local_launchpad {{/str}}">›</a>
      </div>
    </div>
    <div class="lp-cal-dayview-body">
    {{#has_day_items}}
      <ul class="lp-course-list lp-cal-list">
        {{#day_items}}
          <li>
            <button type="button" class="lp-cal-list-btn"
              {{> local_launchpad/fellowship_calendar_event_open}}>
              <b>{{{name}}}</b>
              <span class="lp-muted">{{when}}{{#when_end}} – {{when_end}}{{/when_end}}{{#course_name}} · {{{course_name}}}{{/course_name}}{{#has_location}} · {{location}}{{/has_location}}</span>
            </button>
          </li>
        {{/day_items}}
      </ul>
    {{/has_day_items}}
    {{^has_day_items}}
      <div class="lp-empty" role="status">
        <div class="lp-empty-mark" aria-hidden="true">··</div>
        <h2>{{#str}} fellowship_calendar_day_empty_title, local_launchpad {{/str}}</h2>
        <p>{{#str}} fellowship_calendar_day_empty_body, local_launchpad {{/str}}</p>
        {{#can_add_event}}
          <div class="lp-empty-actions">
            <button type="button" class="lp-btn lp-btn-solid" data-lp-cal-day-add data-day-key="{{day_key}}">
              {{#str}} fellowship_calendar_add_event, local_launchpad {{/str}}
            </button>
          </div>
        {{/can_add_event}}
      </div>
    {{/has_day_items}}
    </div>
  </div>
{{/mode_day}}

{{#mode_upcoming}}
  {{#has_upcoming_items}}
    <ul class="lp-course-list lp-cal-list" data-lp-cal-upcoming-list data-page-size="{{upcoming_page_size}}">
      {{#upcoming_items}}
        <li{{#paged_out}} class="is-paged-out" hidden{{/paged_out}}>
          <button type="button" class="lp-cal-list-btn"
            {{> local_launchpad/fellowship_calendar_event_open}}>
            <b>{{{name}}}</b>
            <span class="lp-muted">{{when}}{{#course_name}} · {{{course_name}}}{{/course_name}}</span>
          </button>
        </li>
      {{/upcoming_items}}
    </ul>
    {{#upcoming_has_more}}
      <p class="lp-cal-upcoming-more-wrap">
        <button type="button" class="lp-btn lp-btn-light" data-lp-cal-upcoming-more
          data-remaining="{{upcoming_more_count}}">
          {{#str}} fellowship_calendar_show_more_upcoming, local_launchpad, {{upcoming_more_count}} {{/str}}
        </button>
      </p>
    {{/upcoming_has_more}}
  {{/has_upcoming_items}}
  {{^has_upcoming_items}}
    <div class="lp-empty" role="status">
      <div class="lp-empty-mark" aria-hidden="true">··</div>
      <h2>{{#str}} fellowship_calendar_empty_title, local_launchpad {{/str}}</h2>
      <p>{{#str}} fellowship_calendar_empty_body, local_launchpad {{/str}}</p>
      {{#can_add_event}}
        <div class="lp-empty-actions">
          <button type="button" class="lp-btn lp-btn-solid" data-lp-cal-add>{{#str}} fellowship_calendar_add_event, local_launchpad {{/str}}</button>
        </div>
      {{/can_add_event}}
    </div>
  {{/has_upcoming_items}}
{{/mode_upcoming}}

<div class="lp-cal-daypanel" data-lp-cal-daypanel hidden>
  <div class="lp-cal-daypanel-scrim" data-lp-cal-daypanel-close aria-hidden="true"></div>
  <div class="lp-cal-daypanel-card" role="dialog" aria-modal="true" aria-labelledby="lp-cal-daypanel-title">
    <p class="lp-eyebrow">{{#str}} fellowship_calendar_day_heading, local_launchpad {{/str}}</p>
    <h2 id="lp-cal-daypanel-title" data-lp-cal-daypanel-title></h2>
    <ul class="lp-course-list lp-cal-list" data-lp-cal-daypanel-list></ul>
    <div class="lp-cal-detail-actions">
      <button type="button" class="lp-btn lp-btn-light" data-lp-cal-daypanel-close>{{#str}} fellowship_calendar_close, local_launchpad {{/str}}</button>
    </div>
  </div>
</div>

<div class="lp-cal-detail" data-lp-cal-detail hidden>
  <div class="lp-cal-detail-scrim" data-lp-cal-detail-close aria-hidden="true"></div>
  <div class="lp-cal-detail-card" role="dialog" aria-modal="true" aria-labelledby="lp-cal-detail-title">
    <p class="lp-eyebrow" data-lp-cal-detail-course></p>
    <h2 id="lp-cal-detail-title" data-lp-cal-detail-title></h2>
    <p class="lp-sm lp-muted" data-lp-cal-detail-when></p>
    <p class="lp-sm lp-cal-detail-location" data-lp-cal-detail-location hidden></p>
    <div class="lp-sm lp-cal-detail-html" data-lp-cal-detail-html hidden></div>
    <p class="lp-xs lp-muted" data-lp-cal-detail-module hidden>{{#str}} fellowship_calendar_module_note, local_launchpad {{/str}}</p>
    <div class="lp-cal-detail-actions">
      <button type="button" class="lp-btn lp-btn-light" data-lp-cal-detail-edit hidden>{{#str}} fellowship_calendar_edit, local_launchpad {{/str}}</button>
      <button type="button" class="lp-btn lp-btn-light" data-lp-cal-detail-close>{{#str}} fellowship_calendar_close, local_launchpad {{/str}}</button>
    </div>
  </div>
</div>

<div class="lp-cal-form" data-lp-cal-form hidden>
  <div class="lp-cal-form-scrim" data-lp-cal-form-close aria-hidden="true"></div>
  <form class="lp-cal-form-card" data-lp-cal-form-el novalidate role="dialog" aria-modal="true" aria-labelledby="lp-cal-form-title">
    <header class="lp-cal-form-head">
      <div class="lp-cal-form-head-copy">
        <span class="lp-cal-form-head-ico" aria-hidden="true">
          <iconify-icon icon="hugeicons:calendar-add-01" width="20" height="20"></iconify-icon>
        </span>
        <div>
          <h2 id="lp-cal-form-title" data-lp-cal-form-title>{{#str}} fellowship_calendar_add_event, local_launchpad {{/str}}</h2>
          <p class="lp-cal-form-help" data-lp-cal-form-help>{{#str}} fellowship_calendar_personal_help, local_launchpad {{/str}}</p>
          <p class="lp-cal-form-help" data-lp-cal-form-help-course hidden>{{#str}} fellowship_calendar_course_help, local_launchpad {{/str}}</p>
        </div>
      </div>
      <button type="button" class="lp-cal-form-x" data-lp-cal-form-close aria-label="{{#str}} fellowship_calendar_close, local_launchpad {{/str}}">
        <iconify-icon icon="hugeicons:cancel-01" width="18" height="18" aria-hidden="true"></iconify-icon>
      </button>
    </header>

    <div class="lp-cal-form-scroll">
      <input type="hidden" name="id" value="" data-lp-cal-form-id>
      {{#has_scope_choice}}
        <fieldset class="lp-cal-form-section lp-cal-seg" data-lp-cal-form-scope-wrap>
          <legend>{{#str}} fellowship_calendar_field_scope, local_launchpad {{/str}}</legend>
          <div class="lp-cal-seg-track" role="presentation">
            <label class="lp-cal-seg-opt">
              <input type="radio" name="scope" value="personal" data-lp-cal-form-scope checked>
              <span>{{#str}} fellowship_calendar_scope_personal, local_launchpad {{/str}}</span>
            </label>
            <label class="lp-cal-seg-opt">
              <input type="radio" name="scope" value="course" data-lp-cal-form-scope>
              <span>{{#str}} fellowship_calendar_scope_course, local_launchpad {{/str}}</span>
            </label>
          </div>
        </fieldset>
      {{/has_scope_choice}}
      {{^has_scope_choice}}
        <input type="hidden" name="scope" value="{{default_scope}}" data-lp-cal-form-scope-fixed>
      {{/has_scope_choice}}

      {{#can_add_course}}
        <label class="lp-cal-field" data-lp-cal-form-course-wrap{{#has_scope_choice}} hidden{{/has_scope_choice}}{{^has_scope_choice}}{{#can_add_personal}} hidden{{/can_add_personal}}{{/has_scope_choice}}>
          <span>{{#str}} fellowship_calendar_field_course, local_launchpad {{/str}}</span>
          <select name="courseid" data-lp-cal-form-course>
            {{#manageable_courses}}
              <option value="{{id}}">{{name}}</option>
            {{/manageable_courses}}
          </select>
        </label>
      {{/can_add_course}}

      <label class="lp-cal-field">
        <span>{{#str}} fellowship_calendar_field_name, local_launchpad {{/str}}</span>
        <input type="text" name="name" required maxlength="200" data-lp-cal-form-name
          placeholder="{{#str}} fellowship_calendar_name_placeholder, local_launchpad {{/str}}">
      </label>

      <div class="lp-cal-form-section">
        <p class="lp-cal-form-section-label">{{#str}} fellowship_calendar_section_when, local_launchpad {{/str}}</p>
        <div class="lp-cal-field-row">
          <label class="lp-cal-field">
            <span>{{#str}} fellowship_calendar_field_date, local_launchpad {{/str}}</span>
            <input type="date" name="date" required data-lp-cal-form-date>
          </label>
          <label class="lp-cal-field">
            <span>{{#str}} fellowship_calendar_field_time, local_launchpad {{/str}}</span>
            <input type="time" name="time" required data-lp-cal-form-time>
          </label>
        </div>
      </div>

      <fieldset class="lp-cal-form-section lp-cal-seg" data-lp-cal-form-duration-mode-wrap>
        <legend>{{#str}} fellowship_calendar_field_duration_mode, local_launchpad {{/str}}</legend>
        <div class="lp-cal-seg-track" role="presentation">
          <label class="lp-cal-seg-opt">
            <input type="radio" name="duration_mode" value="none" data-lp-cal-form-duration-mode checked>
            <span>{{#str}} fellowship_calendar_duration_none, local_launchpad {{/str}}</span>
          </label>
          <label class="lp-cal-seg-opt">
            <input type="radio" name="duration_mode" value="until" data-lp-cal-form-duration-mode>
            <span>{{#str}} fellowship_calendar_duration_until, local_launchpad {{/str}}</span>
          </label>
          <label class="lp-cal-seg-opt">
            <input type="radio" name="duration_mode" value="minutes" data-lp-cal-form-duration-mode>
            <span>{{#str}} fellowship_calendar_duration_minutes, local_launchpad {{/str}}</span>
          </label>
        </div>
      </fieldset>

      <div class="lp-cal-field-row" data-lp-cal-form-until-wrap hidden>
        <label class="lp-cal-field">
          <span>{{#str}} fellowship_calendar_field_end_date, local_launchpad {{/str}}</span>
          <input type="date" name="end_date" data-lp-cal-form-end-date>
        </label>
        <label class="lp-cal-field">
          <span>{{#str}} fellowship_calendar_field_end_time, local_launchpad {{/str}}</span>
          <input type="time" name="end_time" data-lp-cal-form-end-time>
        </label>
      </div>

      <label class="lp-cal-field" data-lp-cal-form-minutes-wrap hidden>
        <span>{{#str}} fellowship_calendar_field_duration, local_launchpad {{/str}}</span>
        <input type="number" name="duration" min="0" step="5" value="0" data-lp-cal-form-duration>
      </label>

      <label class="lp-cal-field">
        <span>{{#str}} fellowship_calendar_field_location, local_launchpad {{/str}}</span>
        <input type="text" name="location" maxlength="255" data-lp-cal-form-location
          placeholder="{{#str}} fellowship_calendar_location_placeholder, local_launchpad {{/str}}">
      </label>

      <div class="lp-cal-form-section" data-lp-cal-form-repeat-wrap>
        <label class="lp-cal-field">
          <span>{{#str}} fellowship_calendar_field_repeat, local_launchpad {{/str}}</span>
          <select name="repeat_mode" data-lp-cal-form-repeat-mode>
            <option value="none">{{#str}} fellowship_calendar_repeat_none, local_launchpad {{/str}}</option>
            <option value="weekly">{{#str}} fellowship_calendar_repeat_weekly, local_launchpad {{/str}}</option>
          </select>
        </label>
        <label class="lp-cal-field" data-lp-cal-form-repeat-count-wrap hidden>
          <span>{{#str}} fellowship_calendar_field_repeat_count, local_launchpad {{/str}}</span>
          <input type="number" name="repeats" min="2" max="52" value="4" data-lp-cal-form-repeats>
          <span class="lp-xs lp-muted">{{#str}} fellowship_calendar_repeat_help, local_launchpad {{/str}}</span>
        </label>
      </div>

      <label class="lp-cal-field">
        <span>{{#str}} fellowship_calendar_field_description, local_launchpad {{/str}}</span>
        <textarea name="description" rows="3" maxlength="5000" data-lp-cal-form-description
          placeholder="{{#str}} fellowship_calendar_description_placeholder, local_launchpad {{/str}}"></textarea>
      </label>

      <p class="lp-cal-form-error lp-sm" data-lp-cal-form-error hidden role="alert"></p>
    </div>

    <div class="lp-cal-form-footer">
      <button type="button" class="lp-btn lp-btn-light lp-cal-form-delete" data-lp-cal-form-delete hidden>
        {{#str}} fellowship_calendar_delete, local_launchpad {{/str}}
      </button>
      <div class="lp-cal-form-footer-main">
        <button type="button" class="lp-btn lp-btn-light" data-lp-cal-form-close>{{#str}} fellowship_calendar_cancel, local_launchpad {{/str}}</button>
        <button type="submit" class="lp-btn lp-btn-solid" data-lp-cal-form-save>{{#str}} fellowship_calendar_save, local_launchpad {{/str}}</button>
      </div>
    </div>
  </form>
</div>
</div>
