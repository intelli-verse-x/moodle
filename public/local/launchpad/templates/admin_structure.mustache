{{!
    @template local_launchpad/admin_structure

    Admin Structure — manage existing tracks (hide / delete).
    Create tracks in Course builder (not a CLI dump).
}}
<div class="lp-st" data-region="local-launchpad-admin-structure">

  <section class="lp-hero lp-st-hero">
    <div class="lp-hero-row">
      <div class="lp-hero-main">
        <span class="lp-eyebrow">{{eyebrow}}</span>
        <h2>{{heading}}</h2>
        <p class="lp-hero-lead">{{lead}}</p>
        <div class="lp-st-links" style="margin-top:12px">
          {{#show_builder_cta}}
            <a class="lp-btn lp-btn-solid lp-btn-sm" href="{{builder_url}}">{{create_in_builder_label}}</a>
            <a class="lp-btn lp-btn-light lp-btn-sm" href="{{builder_url}}">{{builder_label}}</a>
          {{/show_builder_cta}}
          {{#show_cohorts_cta}}
            <a class="lp-btn lp-btn-light lp-btn-sm" href="{{cohorts_url}}">{{cohorts_label}}</a>
          {{/show_cohorts_cta}}
          <a class="lp-btn lp-btn-light lp-btn-sm" href="{{tracks_url}}">{{tracks_label}}</a>
        </div>
      </div>
    </div>
  </section>

  {{#flash_ok}}
    <div class="lp-flash is-ok" role="status">{{flash_ok_body}}</div>
  {{/flash_ok}}
  {{#flash_err}}
    <div class="lp-flash is-err" role="alert">{{flash_err_body}}</div>
  {{/flash_err}}

  {{#has_existing}}
    <section class="lp-card soft lp-st-existing" aria-label="{{existing_title}}">
      <div class="lp-card-head">
        <h3>{{existing_title}}</h3>
        <p class="lp-muted lp-sm">{{existing_lead}}</p>
      </div>
      <div class="lp-st-table-wrap">
        <table class="lp-st-table">
          <thead>
            <tr>
              <th scope="col">{{existing_col_name}}</th>
              <th scope="col">{{existing_col_kind}}</th>
              <th scope="col">{{existing_col_idnumber}}</th>
              <th scope="col">{{existing_col_visibility}}</th>
            </tr>
          </thead>
          <tbody>
            {{#existing_rows}}
              <tr>
                <td><b>{{fullname}}</b></td>
                <td>{{kind_label}}</td>
                <td><code class="lp-tr-idn">{{idnumber}}</code></td>
                <td>
                  <span class="lp-st-vis{{#is_visible}} is-on{{/is_visible}}{{^is_visible}} is-off{{/is_visible}}">{{visibility_label}}</span>
                </td>
              </tr>
            {{/existing_rows}}
          </tbody>
        </table>
      </div>
    </section>

    <section class="lp-card soft lp-st-danger" aria-label="{{danger_title}}">
      <div class="lp-card-head">
        <h3>{{danger_title}}</h3>
        <p class="lp-muted lp-sm">{{danger_lead}}</p>
      </div>
      <div class="lp-st-danger-list">
        {{#existing_rows}}
          <article class="lp-st-danger-row">
            <div class="lp-st-danger-meta">
              <p class="lp-st-danger-name"><b>{{fullname}}</b>
                <span class="lp-muted lp-sm"> · {{kind_label}}</span>
              </p>
              <p class="lp-sm lp-muted">
                <code class="lp-tr-idn">{{idnumber}}</code>
                · {{enrol_count_label}}
                ·
                <span class="lp-st-vis{{#is_visible}} is-on{{/is_visible}}{{^is_visible}} is-off{{/is_visible}}">{{visibility_label}}</span>
              </p>
            </div>
            <div class="lp-st-danger-actions">
              {{#is_visible}}
                <form method="post" action="{{form_action}}" class="lp-inline-form">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <input type="hidden" name="action" value="structure_hide">
                  <input type="hidden" name="cohort" value="{{cohort_value}}">
                  <input type="hidden" name="courseid" value="{{courseid}}">
                  <button type="submit" class="lp-btn lp-btn-light lp-btn-sm">{{danger_hide_label}}</button>
                </form>
                <p class="lp-sm lp-muted">{{danger_delete_need_hide}}</p>
              {{/is_visible}}
              {{#is_hidden}}
                <form method="post" action="{{form_action}}" class="lp-inline-form">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <input type="hidden" name="action" value="structure_unhide">
                  <input type="hidden" name="cohort" value="{{cohort_value}}">
                  <input type="hidden" name="courseid" value="{{courseid}}">
                  <button type="submit" class="lp-btn lp-btn-light lp-btn-sm">{{danger_unhide_label}}</button>
                </form>
                <form method="post" action="{{form_action}}" class="lp-st-danger-delete">
                  <input type="hidden" name="sesskey" value="{{sesskey}}">
                  <input type="hidden" name="action" value="structure_delete">
                  <input type="hidden" name="cohort" value="{{cohort_value}}">
                  <input type="hidden" name="courseid" value="{{courseid}}">
                  <p class="lp-sm lp-st-danger-warn">{{danger_delete_warn}}</p>
                  <label class="lp-field">
                    <span>{{danger_confirm_label}}</span>
                    <input type="text" name="confirmtext" value="" required maxlength="200" autocomplete="off" placeholder="{{idnumber}}">
                  </label>
                  <p class="lp-sm lp-muted">{{danger_confirm_help}}</p>
                  <button type="submit" class="lp-btn lp-btn-light lp-btn-sm lp-btn-danger">{{danger_delete_label}}</button>
                </form>
              {{/is_hidden}}
            </div>
          </article>
        {{/existing_rows}}
      </div>
    </section>
  {{/has_existing}}

  {{^has_existing}}
    <section class="lp-card soft lp-st-empty" role="status">
      <h3>{{empty_manage_title}}</h3>
      <p class="lp-muted">{{empty_manage_body}}</p>
      <p class="lp-empty-actions" style="margin-top:12px">
        <a class="lp-btn lp-btn-solid" href="{{builder_url}}">{{create_in_builder_label}}</a>
      </p>
    </section>
  {{/has_existing}}

</div>
