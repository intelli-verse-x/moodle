{{!
    @template local_launchpad/employer_calendar

    Calendar — upcoming Moodle events; Open in Moodle for full calendar.
}}
<div class="lp-tools-page lp-reveal" data-region="employer-calendar" style="--lp-d:0">
  {{#has_crumbs}}
    <nav class="lp-crumbs" aria-label="Breadcrumb">
      {{#crumbs}}
        {{#has_url}}<a href="{{url}}">{{label}}</a><span aria-hidden="true">/</span>{{/has_url}}
        {{^has_url}}<span aria-current="page">{{label}}</span>{{/has_url}}
      {{/crumbs}}
    </nav>
  {{/has_crumbs}}

  <div class="lp-tools-head">
    <p class="lp-tools-lead">{{page_intro}}</p>
    <a class="lp-btn lp-btn-light" href="{{moodle_url}}">{{strings.calendar_open_moodle}}</a>
  </div>

  {{#has_items}}
    <ul class="lp-course-list lp-cal-list lp-tools-list">
      {{#page_items}}
        <li>
          <a href="{{url}}">
            <b>{{name}}</b>
            <span class="lp-muted">{{when}}{{#course_name}} · {{course_name}}{{/course_name}}</span>
          </a>
        </li>
      {{/page_items}}
    </ul>
    <p class="lp-xs lp-muted">{{strings.native_tools_note}}</p>
  {{/has_items}}
  {{^has_items}}
    <div class="lp-empty" role="status">
      <div class="lp-empty-mark" aria-hidden="true">
        <iconify-icon icon="hugeicons:calendar-03" width="26" height="26"></iconify-icon>
      </div>
      <h2>{{strings.calendar_empty_title}}</h2>
      <p>{{strings.calendar_empty_body}}</p>
      <div class="lp-empty-actions">
        <a class="lp-btn" href="{{moodle_url}}">{{strings.calendar_open_moodle}}</a>
      </div>
    </div>
  {{/has_items}}
</div>
