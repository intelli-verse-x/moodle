{{!
    @template local_launchpad/mentor_review

    Mentor review room — ToBa chrome; grades via Moodle assign save_grade.
}}
<nav class="lp-crumbs" aria-label="{{#str}} fellowship_breadcrumb, local_launchpad {{/str}}">
  <a href="{{queue_url}}">{{#str}} mentor_nav_queue, local_launchpad {{/str}}</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">{{{fellow_name}}} · {{{assign_name}}}</span>
</nav>

<div class="lp-row-sb lp-review-lead">
  <div>
    <p class="lp-review-fellow">{{{fellow_name}}}</p>
    <p class="lp-muted">
      {{{assign_name}}}
      {{#has_attempt}} · {{#str}} fellowship_feedback_attempt, local_launchpad {{/str}} {{attempt}}{{/has_attempt}}
      {{#submitted_at}} · {{submitted_at}}{{/submitted_at}}
    </p>
  </div>
  <span class="lp-chip {{status_chip_class}}">{{status_chip}}</span>
</div>

{{#has_saved}}
  <div class="lp-review-banner" role="status">{{saved_message}}</div>
{{/has_saved}}
{{#has_error}}
  <div class="lp-review-banner lp-review-banner-err" role="alert">{{error_message}}</div>
{{/has_error}}

{{^can_submit_review}}
  <div class="lp-empty" role="status">
    <div class="lp-empty-mark" aria-hidden="true">··</div>
    <h2>{{#str}} mentor_review_empty_title, local_launchpad {{/str}}</h2>
    <p>{{#str}} mentor_review_empty_body, local_launchpad {{/str}}</p>
    <a class="lp-btn lp-btn-light" href="{{queue_url}}">{{#str}} mentor_nav_queue, local_launchpad {{/str}}</a>
  </div>
{{/can_submit_review}}

{{#can_submit_review}}
  <div class="lp-review-grid">
    <section class="lp-card lift lp-review-evidence">
      <h3>{{#str}} mentor_review_evidence, local_launchpad {{/str}}</h3>
      <p class="lp-xs lp-muted">{{{course_name}}}</p>

      {{#has_files}}
        <ul class="lp-review-files">
          {{#files}}
            <li class="lp-review-file">
              <span class="lp-review-ext" aria-hidden="true">{{ext}}</span>
              <div>
                <b>{{filename}}</b>
                <div class="lp-xs lp-muted">{{filesize}}</div>
              </div>
              <a class="lp-btn lp-btn-light" href="{{url}}" target="_blank" rel="noopener">{{#str}} mentor_review_open_file, local_launchpad {{/str}}</a>
            </li>
          {{/files}}
        </ul>
      {{/has_files}}

      {{#has_onlinetext}}
        <div class="lp-review-paper">
          <span class="lp-xs lp-muted">{{#str}} mentor_review_onlinetext, local_launchpad {{/str}}</span>
          <div class="lp-sm">{{{onlinetext_html}}}</div>
        </div>
      {{/has_onlinetext}}

      {{^has_files}}
        {{^has_onlinetext}}
          <p class="lp-muted">{{#str}} mentor_review_no_evidence_body, local_launchpad {{/str}}</p>
        {{/has_onlinetext}}
      {{/has_files}}
    </section>

    <section class="lp-card lift lp-review-form-card">
      <h3>{{#str}} mentor_review_form_heading, local_launchpad {{/str}}</h3>
      <p class="lp-sm lp-muted">{{#str}} mentor_review_form_lead, local_launchpad {{/str}}</p>

      <form class="lp-review-form" method="post" action="{{form_action}}" id="lp-review-form"
            data-lp-rubric-weights="{{rubric_weights_json}}"
            data-lp-rubric-fractions="{{rubric_fractions_json}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="view" value="review">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="userid" value="{{fellow_id}}">
        <input type="hidden" name="grade_pct" id="lp-grade-pct" value="{{grade_pct}}">

        <div class="lp-review-rubric" role="group" aria-label="{{#str}} mentor_review_rubric_label, local_launchpad {{/str}}">
          {{#rubric_criteria}}
            <div class="lp-review-crit" data-crit-index="{{index}}" data-weight="{{weight}}">
              <div class="lp-review-crit-head">
                <span class="lp-review-crit-label">{{label}}</span>
                <span class="lp-review-crit-pts"><output class="lp-review-crit-score" data-crit-score>{{score}}</output>/{{weight}}</span>
              </div>
              <div class="lp-review-levels" role="radiogroup" aria-label="{{label}}">
                {{#levels}}
                  <label class="lp-review-level">
                    <input type="radio" name="crit_level[{{crit_index}}]" value="{{value}}"
                           data-fraction="{{fraction}}"{{#selected}} checked{{/selected}} required>
                    <span>{{label}}</span>
                  </label>
                {{/levels}}
              </div>
            </div>
          {{/rubric_criteria}}
        </div>

        <div class="lp-review-score-row lp-review-total-row">
          <span class="lp-review-label" id="lp-total-label">{{#str}} mentor_review_total_label, local_launchpad {{/str}}</span>
          <b class="lp-review-total" id="lp-rubric-total" aria-labelledby="lp-total-label">{{rubric_total}}</b>
          <span class="lp-muted">/ 100 · {{#str}} mentor_review_pass_bar, local_launchpad {{/str}} {{pass_bar}}</span>
          <span class="lp-chip lp-review-verdict" id="lp-rubric-verdict"></span>
        </div>

        <fieldset class="lp-review-outcome">
          <legend>{{#str}} mentor_review_outcome_label, local_launchpad {{/str}}</legend>
          <label class="lp-review-radio">
            <input type="radio" name="outcome" value="met"{{#outcome_met}} checked{{/outcome_met}}>
            <span>{{#str}} mentor_review_outcome_met, local_launchpad {{/str}}</span>
          </label>
          <label class="lp-review-radio">
            <input type="radio" name="outcome" value="changes"{{#outcome_changes}} checked{{/outcome_changes}}>
            <span>{{#str}} mentor_review_outcome_changes, local_launchpad {{/str}}</span>
          </label>
        </fieldset>

        <div class="lp-review-nextstep" id="lp-nextstep-wrap"{{^outcome_changes}} hidden{{/outcome_changes}}>
          <label class="lp-review-label" for="lp-nextstep">{{#str}} mentor_review_nextstep_label, local_launchpad {{/str}}</label>
          <input class="lp-review-input lp-review-input-wide" id="lp-nextstep" name="nextstep" type="text"
                 maxlength="280" value="{{next_step}}"
                 placeholder="{{#str}} mentor_review_nextstep_placeholder, local_launchpad {{/str}}"
                 {{#outcome_changes}}required{{/outcome_changes}}>
          <p class="lp-xs lp-muted">{{#str}} mentor_review_nextstep_hint, local_launchpad {{/str}}</p>
        </div>

        <label class="lp-review-label" for="lp-comment">{{#str}} mentor_review_comment_label, local_launchpad {{/str}}</label>
        <textarea class="lp-review-textarea" id="lp-comment" name="comment" rows="6" required
                  placeholder="{{#str}} mentor_review_comment_placeholder, local_launchpad {{/str}}">{{comment}}</textarea>

        <div class="lp-review-actions">
          <button type="submit" class="lp-btn lp-btn-primary">{{#str}} mentor_review_submit, local_launchpad {{/str}}</button>
          <a class="lp-btn lp-btn-light" href="{{queue_url}}">{{#str}} mentor_review_back_queue, local_launchpad {{/str}}</a>
        </div>
      </form>
      <script>
      (function () {
        var form = document.getElementById('lp-review-form');
        var wrap = document.getElementById('lp-nextstep-wrap');
        var input = document.getElementById('lp-nextstep');
        var totalEl = document.getElementById('lp-rubric-total');
        var gradeEl = document.getElementById('lp-grade-pct');
        var verdictEl = document.getElementById('lp-rubric-verdict');
        if (!form) { return; }

        var weights = [];
        var fractions = [0.4, 0.6, 0.8, 1];
        try { weights = JSON.parse(form.getAttribute('data-lp-rubric-weights') || '[]'); } catch (e) { weights = []; }
        try { fractions = JSON.parse(form.getAttribute('data-lp-rubric-fractions') || '[0.4,0.6,0.8,1]'); } catch (e) {}

        var metRadio = form.querySelector('input[name="outcome"][value="met"]');
        var changesRadio = form.querySelector('input[name="outcome"][value="changes"]');
        // True after we forced Changes for &lt;70; used to flip Met back when total clears 70.
        var forcedChangesForPassBar = false;

        function syncOutcomeUi() {
          if (!wrap || !input) { return; }
          var on = !!(changesRadio && changesRadio.checked);
          wrap.hidden = !on;
          if (on) { input.setAttribute('required', 'required'); }
          else { input.removeAttribute('required'); }
        }

        /**
         * Pass bar sync (no Met/Changes conflict):
         * - total &lt; 70 → force Changes, disable Met
         * - total ≥ 70 after a force → auto Met (mentor can still pick Changes after)
         * - total ≥ 70 without a force → only ensure Met is enabled
         */
        function syncOutcomeWithTotal(total) {
          var under = total < 70;
          if (metRadio) {
            metRadio.disabled = under;
          }
          if (under) {
            if (metRadio) { metRadio.checked = false; }
            if (changesRadio) { changesRadio.checked = true; }
            forcedChangesForPassBar = true;
          } else if (forcedChangesForPassBar) {
            if (metRadio) { metRadio.checked = true; }
            if (changesRadio) { changesRadio.checked = false; }
            forcedChangesForPassBar = false;
          }
          syncOutcomeUi();
        }

        if (metRadio) {
          metRadio.addEventListener('change', function () {
            if (metRadio.checked) { forcedChangesForPassBar = false; }
          });
        }
        if (changesRadio) {
          changesRadio.addEventListener('change', function () {
            // Manual Changes at ≥70 is intentional — don't auto-flip back to Met on next calc.
            if (changesRadio.checked) { forcedChangesForPassBar = false; }
          });
        }

        function calc() {
          var total = 0;
          form.querySelectorAll('.lp-review-crit').forEach(function (row) {
            var idx = parseInt(row.getAttribute('data-crit-index'), 10);
            var weight = weights[idx];
            if (weight == null) { weight = parseInt(row.getAttribute('data-weight'), 10) || 0; }
            var checked = row.querySelector('input[type="radio"]:checked');
            var lvl = checked ? parseInt(checked.value, 10) : 1;
            if (isNaN(lvl) || lvl < 0 || lvl > 3) { lvl = 1; }
            var score = Math.round(weight * (fractions[lvl] != null ? fractions[lvl] : 0.6));
            total += score;
            var out = row.querySelector('[data-crit-score]');
            if (out) { out.textContent = String(score); }
          });
          if (totalEl) { totalEl.textContent = String(total); }
          if (gradeEl) { gradeEl.value = String(total); }
          if (verdictEl) {
            var ok = total >= 70;
            verdictEl.textContent = ok ? '70+' : '<70';
            verdictEl.className = 'lp-chip lp-review-verdict ' + (ok ? 'ok' : 'warn');
          }
          syncOutcomeWithTotal(total);
        }

        document.querySelectorAll('input[name="outcome"]').forEach(function (el) {
          el.addEventListener('change', syncOutcomeUi);
        });
        form.querySelectorAll('input[name^="crit_level"]').forEach(function (el) {
          el.addEventListener('change', calc);
        });
        calc();
      })();
      </script>

      <p class="lp-xs lp-muted" style="margin-top:14px">
        {{#str}} mentor_review_moodle_note, local_launchpad {{/str}}
        <a class="lp-link" href="{{moodle_grader_url}}">{{#str}} mentor_review_open_moodle_grader, local_launchpad {{/str}}</a>
      </p>
    </section>
  </div>
{{/can_submit_review}}
