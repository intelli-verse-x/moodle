{{!
    @template local_launchpad/fellowship_activity

    Fellow activity consume — LaunchPad shell over Moodle CM (page/url/resource/quiz/assign in-shell).
}}
{{#activity}}
  <div class="lp-activity-page" data-region="fellowship-activity">
    <nav class="lp-crumbs" aria-label="Breadcrumb">
      <a href="{{home_url}}">{{strings.navhome}}</a>
      <span aria-hidden="true">/</span>
      <a href="{{courseurl}}">{{strings.navtrack}}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{title_main}}</span>
    </nav>

    <article class="lp-activity-hero">
      <div class="lp-activity-hero-copy">
        <div class="lp-activity-badges">
          <span class="lp-activity-badge is-type">{{modname}}</span>
          <span class="lp-activity-badge is-status is-{{statustone}}">{{status}}</span>
        </div>

        <h2 class="lp-activity-title">{{title_main}}</h2>
        {{#hastitlesub}}
          <p class="lp-activity-sub">{{title_sub}}</p>
        {{/hastitlesub}}

        {{#is_lesson}}
          <p class="lp-lesson-meta">
            <span>{{lesson_track_label}}</span>
            {{#hassection}}
              <span aria-hidden="true">·</span>
              <span>{{lesson_phase_label}}</span>
            {{/hassection}}
          </p>
        {{/is_lesson}}

        <div class="lp-activity-head-actions">
          <a class="lp-btn lp-btn-light lp-activity-back" href="{{courseurl}}">{{strings.backtotrack}}</a>
          {{#needsengine}}
            <a class="lp-btn lp-btn-solid" href="{{moodleurl}}">{{strings.openactivity}}</a>
          {{/needsengine}}
          {{#is_lesson}}
            {{#lesson_has_next}}
              <a class="lp-btn lp-btn-solid" href="{{lesson_next_url}}">{{strings.lessonnext}}: {{lesson_next_name}}</a>
            {{/lesson_has_next}}
          {{/is_lesson}}
        </div>

        {{#show_judging}}
          <aside class="lp-judge-note" aria-label="{{judging_title}}">
            <b>{{judging_title}}</b>
            <p>{{judging_body}}</p>
          </aside>
        {{/show_judging}}

        {{#hasintro}}
          <div class="lp-activity-intro">{{{introhtml}}}</div>
        {{/hasintro}}

        {{#isinportal}}
          {{#is_lesson}}
            <div class="lp-lesson-layout" data-region="lesson-layout">
              <section class="lp-lesson-block">
                <h3 class="lp-lesson-block-title">{{strings.lessonobjective}}</h3>
                {{#lesson_has_objective}}
                  <div class="lp-lesson-block-body">{{{lesson_objective_html}}}</div>
                {{/lesson_has_objective}}
                {{^lesson_has_objective}}
                  <p class="lp-muted lp-sm">{{strings.lessonmissing}}</p>
                {{/lesson_has_objective}}
              </section>
              <section class="lp-lesson-block">
                <h3 class="lp-lesson-block-title">{{strings.lessonexplain}}</h3>
                {{#lesson_has_explain}}
                  <div class="lp-lesson-block-body">{{{lesson_explain_html}}}</div>
                {{/lesson_has_explain}}
                {{^lesson_has_explain}}
                  <p class="lp-muted lp-sm">{{strings.lessonmissing}}</p>
                {{/lesson_has_explain}}
              </section>
              <section class="lp-lesson-block">
                <h3 class="lp-lesson-block-title">{{strings.lessonexample}}</h3>
                {{#lesson_has_example}}
                  <div class="lp-lesson-block-body">{{{lesson_example_html}}}</div>
                {{/lesson_has_example}}
                {{^lesson_has_example}}
                  <p class="lp-muted lp-sm">{{strings.lessonmissing}}</p>
                {{/lesson_has_example}}
              </section>
              <section class="lp-lesson-block">
                <h3 class="lp-lesson-block-title">{{strings.lessonexercise}}</h3>
                {{#lesson_has_exercise}}
                  <div class="lp-lesson-block-body">{{{lesson_exercise_html}}}</div>
                {{/lesson_has_exercise}}
                {{^lesson_has_exercise}}
                  <p class="lp-muted lp-sm">{{strings.lessonmissing}}</p>
                {{/lesson_has_exercise}}
              </section>
              {{#lesson_has_next}}
                <div class="lp-lesson-next">
                  <span class="lp-xs lp-muted">{{strings.lessonnextlabel}}</span>
                  <a class="lp-btn lp-btn-solid" href="{{lesson_next_url}}">{{lesson_next_name}}</a>
                </div>
              {{/lesson_has_next}}
            </div>
          {{/is_lesson}}

          {{#hasbody}}
            <div class="lp-activity-body">{{{bodyhtml}}}</div>
          {{/hasbody}}

          {{#isplaceholder}}
            <div class="lp-activity-callout" role="status">
              <div class="lp-activity-callout-text">
                <b>{{strings.contentcomingsoon}}</b>
                <p>{{strings.activityempty}}</p>
              </div>
            </div>
          {{/isplaceholder}}

          {{#hasvideo}}
            <div class="lp-activity-player">
              <video controls playsinline preload="metadata" controlslist="nodownload">
                <source src="{{videourl}}" type="video/mp4">
                Your browser does not support HTML5 video.
              </video>
            </div>
          {{/hasvideo}}

          {{#hasembed}}
            <div class="lp-activity-embed">{{{embedhtml}}}</div>
          {{/hasembed}}

          {{#hasexternal}}
            <div class="lp-activity-external">
              {{^hasembed}}
                <a class="lp-btn lp-btn-solid" href="{{externalurl}}" target="_blank" rel="noopener noreferrer">
                  {{strings.openlink}}
                </a>
              {{/hasembed}}
              {{#hasembed}}
                <a class="lp-btn lp-btn-light lp-btn-sm" href="{{externalurl}}" target="_blank" rel="noopener noreferrer">
                  {{strings.openlink}}
                </a>
              {{/hasembed}}
              <p class="lp-muted lp-sm">{{externalurl}}</p>
            </div>
          {{/hasexternal}}

          {{#hasfiles}}
            <ul class="lp-activity-files">
              {{#files}}
                <li>
                  <a class="lp-activity-file{{#isimage}} has-thumb{{/isimage}}" href="{{url}}" title="{{filename}} — {{download_label}}">
                    {{#isimage}}
                      <span class="lp-activity-file-thumb" aria-hidden="true">
                        <img src="{{previewurl}}" alt="">
                      </span>
                    {{/isimage}}
                    {{^isimage}}
                      <span class="lp-activity-file-ico" aria-hidden="true">{{#ext}}{{ext}}{{/ext}}{{^ext}}FILE{{/ext}}</span>
                    {{/isimage}}
                    <span class="lp-activity-file-body">
                      <span class="lp-activity-file-name">{{displayname}}</span>
                      <span class="lp-activity-file-meta">{{size}} · {{download_label}}</span>
                    </span>
                    <span class="lp-activity-file-action" aria-hidden="true">↓</span>
                  </a>
                </li>
              {{/files}}
            </ul>
          {{/hasfiles}}
        {{/isinportal}}

        {{#is_quiz}}
          {{#quiz_attempting}}
            <div class="lp-quiz-attempt" data-region="quiz-attempt" data-timeleft="{{attempt_timeleft}}">
              <div class="lp-quiz-attempt-bar">
                <span class="lp-quiz-attempt-page">{{attempt_page_label}}</span>
                {{#attempt_has_timer}}
                  <span class="lp-quiz-attempt-timer" data-lp-quiz-timer>{{attempt_timeleft_label}}</span>
                {{/attempt_has_timer}}
              </div>
              <form method="post" action="{{attempt_form_action}}" class="lp-quiz-attempt-form" data-lp-quiz-form data-confirm-finish="{{strings.quizconfirmfinish}}">
                <input type="hidden" name="sesskey" value="{{attempt_sesskey}}">
                <input type="hidden" name="action" value="quiz_process">
                <input type="hidden" name="cmid" value="{{attempt_cmid}}">
                <input type="hidden" name="attempt" value="{{attemptid}}">
                <input type="hidden" name="thispage" value="{{attempt_page}}">
                <input type="hidden" name="nextpage" value="{{attempt_nextpage}}">
                <input type="hidden" name="timeup" value="0" data-lp-quiz-timeup>
                {{#attempt_questions}}
                  <div class="lp-quiz-question" data-slot="{{slot}}">{{{html}}}</div>
                {{/attempt_questions}}
                <div class="lp-quiz-attempt-actions">
                  {{#attempt_has_prev}}
                    <button type="submit" name="previous" value="1" class="lp-btn lp-btn-light">{{strings.quizprev}}</button>
                  {{/attempt_has_prev}}
                  {{^attempt_is_last}}
                    <button type="submit" name="next" value="1" class="lp-btn lp-btn-solid">{{strings.quiznext}}</button>
                  {{/attempt_is_last}}
                  {{#attempt_is_last}}
                    <button type="submit" name="opensummary" value="1" class="lp-btn lp-btn-solid">{{strings.quizopensummary}}</button>
                  {{/attempt_is_last}}
                </div>
              </form>
              {{{end_code}}}
            </div>
          {{/quiz_attempting}}

          {{#quiz_summarising}}
            <div class="lp-quiz-summary" data-region="quiz-summary" data-timeleft="{{attempt_timeleft}}">
              <aside class="lp-judge-note" aria-label="{{strings.quizopensummary}}">
                <b>{{strings.quizopensummary}}</b>
                <p>{{strings.quizsummarylead}}</p>
                <p class="lp-quiz-summary-counts">
                  <span>{{summary_flagged_label}}</span>
                  <span aria-hidden="true">·</span>
                  <span>{{summary_unanswered_label}}</span>
                </p>
                {{#attempt_has_timer}}
                  <p class="lp-quiz-attempt-timer" data-lp-quiz-timer>{{attempt_timeleft_label}}</p>
                {{/attempt_has_timer}}
              </aside>
              {{#summary_has_rows}}
                <ul class="lp-quiz-summary-list">
                  {{#summary_rows}}
                    <li class="lp-quiz-summary-row is-{{status_key}}">
                      <div class="lp-quiz-summary-row-main">
                        <span class="lp-quiz-summary-q">{{number_label}}</span>
                        <span class="lp-chip is-{{status_key}}">{{status_label}}</span>
                      </div>
                      <a class="lp-btn lp-btn-light lp-btn-sm" href="{{jump_url}}">{{strings.quizsummaryjump}}</a>
                    </li>
                  {{/summary_rows}}
                </ul>
              {{/summary_has_rows}}
              <form method="post" action="{{summary_form_action}}" class="lp-quiz-summary-form" data-lp-quiz-form data-confirm-finish="{{strings.quizconfirmfinish}}">
                <input type="hidden" name="sesskey" value="{{summary_sesskey}}">
                <input type="hidden" name="action" value="quiz_process">
                <input type="hidden" name="cmid" value="{{summary_cmid}}">
                <input type="hidden" name="attempt" value="{{attemptid}}">
                <input type="hidden" name="fromsummary" value="1">
                <input type="hidden" name="timeup" value="0" data-lp-quiz-timeup>
                <div class="lp-quiz-attempt-actions">
                  <a class="lp-btn lp-btn-light" href="{{summary_back_url}}">{{strings.quizbackattempt}}</a>
                  <button type="submit" name="finishattempt" value="1" class="lp-btn lp-btn-solid" data-lp-quiz-finish>{{strings.quizsubmit}}</button>
                </div>
              </form>
            </div>
          {{/quiz_summarising}}

          {{#quiz_reviewing}}
            <div class="lp-quiz-review" data-region="quiz-review">
              <aside class="lp-judge-note" aria-label="{{strings.quizstatus}}">
                <b>{{strings.quizstatus}}</b>
                <p>{{review_summary}}</p>
                {{#review_has_grade}}
                  <p class="lp-quiz-review-grade">{{review_grade}}</p>
                {{/review_has_grade}}
              </aside>
              {{#review_has_questions}}
                {{#review_questions}}
                  <div class="lp-quiz-question is-review" data-slot="{{slot}}">{{{html}}}</div>
                {{/review_questions}}
              {{/review_has_questions}}
              <div class="lp-activity-head-actions" style="margin-top:16px">
                <a class="lp-btn lp-btn-light" href="{{review_back_url}}">{{strings.quizbackbrief}}</a>
                <a class="lp-btn lp-btn-solid" href="{{courseurl}}">{{strings.backtotrack}}</a>
              </div>
              {{{end_code}}}
            </div>
          {{/quiz_reviewing}}

          {{^quiz_attempting}}
          {{^quiz_summarising}}
          {{^quiz_reviewing}}
          <div class="lp-assign-layout" data-region="quiz-brief">
            <p class="lp-lesson-meta">
              <span>{{quiz_track_label}}</span>
              {{#quiz_has_phase}}
                <span aria-hidden="true">·</span>
                <span>{{quiz_phase_label}}</span>
              {{/quiz_has_phase}}
            </p>

            <aside class="lp-judge-note" aria-label="{{strings.quizpractice}}">
              <b>{{strings.quizpractice}}</b>
              <p>{{quiz_practice_note}}</p>
            </aside>

            <section class="lp-lesson-block">
              <h3 class="lp-lesson-block-title">{{strings.quizbrief}}</h3>
              {{#quiz_has_brief}}
                <div class="lp-lesson-block-body">{{{quiz_brief_html}}}</div>
              {{/quiz_has_brief}}
              {{^quiz_has_brief}}
                <p class="lp-muted lp-sm">{{strings.quizbriefmissing}}</p>
              {{/quiz_has_brief}}
            </section>

            <dl class="lp-assign-meta">
              {{#quiz_has_questions}}
                <div>
                  <dt>{{strings.quizquestions}}</dt>
                  <dd>{{quiz_questions}}</dd>
                </div>
              {{/quiz_has_questions}}
              {{#quiz_has_attempts}}
                <div>
                  <dt>{{strings.quizattempts}}</dt>
                  <dd>{{quiz_attempts_label}}</dd>
                </div>
              {{/quiz_has_attempts}}
              {{#quiz_has_timelimit}}
                <div>
                  <dt>{{strings.quiztimelimit}}</dt>
                  <dd{{^quiz_timelimit_set}} class="lp-muted"{{/quiz_timelimit_set}}>{{quiz_timelimit}}</dd>
                </div>
              {{/quiz_has_timelimit}}
              {{#quiz_has_opens}}
                <div>
                  <dt>{{strings.quizopens}}</dt>
                  <dd>{{quiz_opens}}</dd>
                </div>
              {{/quiz_has_opens}}
              {{#quiz_has_closes}}
                <div>
                  <dt>{{strings.quizcloses}}</dt>
                  <dd{{^quiz_closes_set}} class="lp-muted"{{/quiz_closes_set}}>{{quiz_closes}}</dd>
                </div>
              {{/quiz_has_closes}}
              {{#quiz_has_grade}}
                <div>
                  <dt>{{strings.quizgrade}}</dt>
                  <dd>{{quiz_grade_max}}</dd>
                </div>
              {{/quiz_has_grade}}
              {{#quiz_has_best_grade}}
                <div>
                  <dt>{{strings.quizbest}}</dt>
                  <dd>{{quiz_best_grade}}</dd>
                </div>
              {{/quiz_has_best_grade}}
              {{#quiz_has_attempt_status}}
                <div>
                  <dt>{{strings.quizstatus}}</dt>
                  <dd><span class="lp-chip is-{{quiz_attempt_status_key}}">{{quiz_attempt_status}}</span></dd>
                </div>
              {{/quiz_has_attempt_status}}
            </dl>

            <div class="lp-quiz-cta">
              {{#quiz_no_questions}}
                <p class="lp-muted lp-sm">{{strings.quiznoquestions}}</p>
              {{/quiz_no_questions}}
              {{#quiz_exhausted}}
                <p class="lp-muted lp-sm">{{strings.quizexhausted}}</p>
              {{/quiz_exhausted}}
              {{#quiz_can_continue}}
                <a class="lp-btn lp-btn-solid" href="{{quiz_continue_url}}">{{strings.quizresume}}</a>
              {{/quiz_can_continue}}
              {{#quiz_can_start}}
                <a class="lp-btn lp-btn-solid" href="{{quiz_start_url}}">{{strings.quizstart}}</a>
              {{/quiz_can_start}}
              {{#quiz_can_review}}
                <a class="lp-btn lp-btn-light" href="{{quiz_review_url}}">{{strings.quizreview}}</a>
              {{/quiz_can_review}}
            </div>
          </div>
          {{/quiz_reviewing}}
          {{/quiz_summarising}}
          {{/quiz_attempting}}
        {{/is_quiz}}

        {{#is_assign}}
          <div class="lp-assign-layout" data-region="assign-workspace">
            <p class="lp-lesson-meta">
              <span>{{assign_track_label}}</span>
              {{#assign_has_phase}}
                <span aria-hidden="true">·</span>
                <span>{{assign_phase_label}}</span>
              {{/assign_has_phase}}
            </p>

            {{#assign_has_flash_ok}}
              <p class="lp-flash ok" role="status">{{assign_flash_ok}}</p>
            {{/assign_has_flash_ok}}
            {{#assign_has_flash_err}}
              <p class="lp-flash err" role="alert">{{assign_flash_err}}</p>
            {{/assign_has_flash_err}}

            <section class="lp-lesson-block">
              <h3 class="lp-lesson-block-title">{{strings.assignbrief}}</h3>
              {{#assign_has_brief}}
                <div class="lp-lesson-block-body">{{{assign_brief_html}}}</div>
              {{/assign_has_brief}}
              {{^assign_has_brief}}
                <p class="lp-muted lp-sm">{{strings.assignbriefmissing}}</p>
              {{/assign_has_brief}}
            </section>

            {{#assign_has_deliverable}}
              <section class="lp-lesson-block">
                <h3 class="lp-lesson-block-title">{{strings.assigndeliverable}}</h3>
                <p class="lp-lesson-block-body">{{assign_deliverable}}</p>
              </section>
            {{/assign_has_deliverable}}

            {{#assign_has_criteria}}
              <section class="lp-lesson-block">
                <h3 class="lp-lesson-block-title">{{strings.assigncriteria}}</h3>
                <div class="lp-lesson-block-body">{{{assign_criteria_html}}}</div>
              </section>
            {{/assign_has_criteria}}

            <dl class="lp-assign-meta">
              {{#assign_has_formats}}
                <div>
                  <dt>{{strings.assignformats}}</dt>
                  <dd>{{assign_formats}}</dd>
                </div>
              {{/assign_has_formats}}
              <div>
                <dt>{{strings.assigndeadline}}</dt>
                <dd{{^assign_deadline_set}} class="lp-muted"{{/assign_deadline_set}}>{{assign_deadline}}</dd>
              </div>
              {{#assign_has_opens}}
                <div>
                  <dt>{{strings.assignopens}}</dt>
                  <dd>{{assign_opens}}</dd>
                </div>
              {{/assign_has_opens}}
              {{#assign_has_grade}}
                <div>
                  <dt>{{strings.assigngrade}}</dt>
                  <dd>{{assign_grade_max}} · {{strings.assignpassbar}} {{assign_pass_bar}}</dd>
                </div>
              {{/assign_has_grade}}
              {{#assign_has_sub_status}}
                <div>
                  <dt>{{strings.assignstatus}}</dt>
                  <dd><span class="lp-chip {{#assign_sub_status_key}}is-{{assign_sub_status_key}}{{/assign_sub_status_key}}">{{assign_sub_status}}</span></dd>
                </div>
              {{/assign_has_sub_status}}
              <div>
                <dt>{{strings.assignattempt}}</dt>
                <dd>{{assign_attempt_label}}</dd>
              </div>
              <div>
                <dt>{{strings.assigncompletion}}</dt>
                <dd>{{assign_completion_note}}</dd>
              </div>
            </dl>

            {{#assign_has_feedback}}
              <section class="lp-lesson-block lp-assign-feedback" data-region="assign-feedback">
                <h3 class="lp-lesson-block-title">{{strings.assignfeedback}}</h3>
                {{#assign_has_feedback_attempt}}
                  <p class="lp-sm lp-muted">{{assign_feedback_attempt_label}}</p>
                {{/assign_has_feedback_attempt}}
                {{#assign_has_feedback_grade}}
                  <p class="lp-assign-feedback-grade"><b>{{strings.assigngrade}}:</b> {{assign_feedback_grade}}</p>
                {{/assign_has_feedback_grade}}
                {{#assign_feedback_when}}
                  <p class="lp-sm lp-muted">{{assign_feedback_when}}{{#assign_has_feedback_by}} · {{assign_feedback_by}}{{/assign_has_feedback_by}}</p>
                {{/assign_feedback_when}}
                {{#assign_has_feedback_html}}
                  <div class="lp-lesson-block-body">{{{assign_feedback_html}}}</div>
                {{/assign_has_feedback_html}}
              </section>
            {{/assign_has_feedback}}

            {{#assign_has_current_files}}
              <section class="lp-lesson-block">
                <h3 class="lp-lesson-block-title">{{strings.assignfiles}}</h3>
                <ul class="lp-assign-file-list">
                  {{#assign_current_files}}
                    <li><a href="{{url}}" target="_blank" rel="noopener">{{filename}}</a> <span class="lp-muted lp-sm">{{filesize}}</span></li>
                  {{/assign_current_files}}
                </ul>
              </section>
            {{/assign_has_current_files}}

            {{#assign_can_edit}}
              <section class="lp-lesson-block">
                <h3 class="lp-lesson-block-title">{{strings.assignsubmitsection}}</h3>
                {{#assign_prefilled}}
                  <p class="lp-sm lp-assign-prefill-note">{{assign_prefilled_label}}</p>
                {{/assign_prefilled}}
                <form method="post" action="{{assign_form_action}}" enctype="multipart/form-data" class="lp-assign-submit-form" data-region="assign-submit">
                  <input type="hidden" name="sesskey" value="{{assign_sesskey}}">
                  <input type="hidden" name="action" value="assign_process">
                  <input type="hidden" name="cmid" value="{{assign_cmid}}">
                  <input type="hidden" name="lastmodified" value="{{assign_lastmodified}}">
                  {{#assign_has_text}}
                    <label class="lp-field">
                      <span>{{strings.assignonlinetext}}</span>
                      <textarea name="onlinetext" rows="10" maxlength="100000">{{assign_draft_text}}</textarea>
                    </label>
                  {{/assign_has_text}}
                  {{#assign_has_file}}
                    <label class="lp-field">
                      <span>{{strings.assignfileupload}}</span>
                      <input type="file" name="assignfile">
                      <span class="lp-sm lp-muted">{{strings.assignfilehint}}</span>
                    </label>
                  {{/assign_has_file}}
                  {{#assign_require_statement}}
                    <label class="lp-field lp-field-check">
                      <span class="lp-field-check-row">
                        <input type="checkbox" name="submissionstatement" value="1" required>
                        <span>{{assign_statement_label}}</span>
                      </span>
                    </label>
                  {{/assign_require_statement}}
                  <div class="lp-quiz-attempt-actions">
                    <button type="submit" name="assign_save" value="1" class="lp-btn lp-btn-light">{{strings.assignsavedraft}}</button>
                    <button type="submit" name="assign_submit" value="1" class="lp-btn lp-btn-solid">{{strings.assignsubmit}}</button>
                  </div>
                </form>
              </section>
            {{/assign_can_edit}}
            {{^assign_can_edit}}
              {{#assign_has_draft_html}}
                <section class="lp-lesson-block">
                  <h3 class="lp-lesson-block-title">{{strings.assignonlinetext}}</h3>
                  <div class="lp-lesson-block-body">{{{assign_draft_html}}}</div>
                </section>
              {{/assign_has_draft_html}}
              <p class="lp-muted lp-sm">{{strings.assignlockednote}}</p>
            {{/assign_can_edit}}

            {{#assign_has_prior_attempts}}
              <section class="lp-lesson-block">
                <h3 class="lp-lesson-block-title">{{strings.assignpriors}}</h3>
                <ul class="lp-assign-prior-list">
                  {{#assign_prior_attempts}}
                    <li class="lp-assign-prior">
                      <div class="lp-assign-prior-head">
                        <b>{{attempt_label}}</b>
                        <span class="lp-chip">{{status_label}}</span>
                        <span class="lp-sm lp-muted">{{modified}}</span>
                      </div>
                      {{#has_grade}}
                        <p class="lp-sm"><b>{{strings.assigngrade}}:</b> {{grade_label}}</p>
                      {{/has_grade}}
                      {{#has_feedback}}
                        <div class="lp-assign-prior-feedback">
                          <p class="lp-sm"><b>{{strings.assignfeedback}}:</b></p>
                          <div class="lp-lesson-block-body">{{{feedback_html}}}</div>
                        </div>
                      {{/has_feedback}}
                      {{#has_text}}
                        <div class="lp-lesson-block-body">{{{text_html}}}</div>
                      {{/has_text}}
                    </li>
                  {{/assign_prior_attempts}}
                </ul>
              </section>
            {{/assign_has_prior_attempts}}
          </div>
        {{/is_assign}}

        {{#needsengine}}
          {{^is_quiz}}
          {{^is_assign}}
          <div class="lp-activity-callout" role="status">
            <div class="lp-activity-callout-text">
              <b>{{strings.openactivity}}</b>
              <p>{{strings.activityenginehelp}}</p>
              <a class="lp-btn lp-btn-solid" href="{{moodleurl}}">{{strings.openactivity}}</a>
            </div>
          </div>
          {{/is_assign}}
