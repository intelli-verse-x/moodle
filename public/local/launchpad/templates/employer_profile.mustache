{{!
    @template local_launchpad/employer_profile

    Profile — account overview, edit form, and preferences hub.
    Fellowship passes hide_moodle_escapes to drop Full editor / Open public profile.
    All three tab panels ship in the DOM; JS switches them without a full reload.
}}
<div class="lp-tools-page lp-reveal"
     data-region="launchpad-profile"
     data-lp-profile
     data-lp-profile-active="{{#ptab_overview}}overview{{/ptab_overview}}{{#ptab_edit}}edit{{/ptab_edit}}{{#ptab_preferences}}preferences{{/ptab_preferences}}"
     style="--lp-d:0">
  {{#has_flash}}
    {{#flash}}
      <div class="lp-flash{{#ok}} is-ok{{/ok}}{{^ok}} is-err{{/ok}}" role="status">{{text}}</div>
    {{/flash}}
  {{/has_flash}}

  <section class="lp-card lift lp-theme-hero lp-profile-hero">
    <div class="lp-theme-hero-main">
      <div class="lp-profile-hero-who">
        {{#has_picture}}
          <img class="lp-profile-avatar" src="{{picture_url}}" alt="" width="72" height="72">
        {{/has_picture}}
        {{^has_picture}}
          <span class="lp-av lp-profile-avatar-fallback" aria-hidden="true">{{initials}}</span>
        {{/has_picture}}
        <div class="lp-card-copy">
          <div class="lp-theme-hero-heading">
            <h3>{{displayname}}</h3>
          </div>
          {{#has_email}}<p class="lp-sm lp-muted">{{email}}</p>{{/has_email}}
          <p class="lp-sm lp-theme-hero-body">{{strings.profile_intro}}</p>
        </div>
      </div>
      <div class="lp-profile-hero-actions">
        {{! Edit tab opens the in-portal form. Moodle escapes are Employer-only. }}
        {{#has_edit_external}}
          <a class="lp-btn lp-btn-primary" href="{{edit_external_url}}">{{strings.profile_edit_external}}</a>
        {{/has_edit_external}}
        {{^hide_moodle_escapes}}
          {{^can_edit}}
            {{^has_edit_external}}
              <a class="lp-btn lp-btn-primary" href="{{moodle_edit_url}}">{{strings.profile_edit_moodle}}</a>
            {{/has_edit_external}}
          {{/can_edit}}
          <a class="lp-btn lp-btn-light" href="{{moodle_url}}">{{strings.profile_open_moodle}}</a>
        {{/hide_moodle_escapes}}
      </div>
    </div>
    <div class="lp-theme-hero-art" aria-hidden="true">
      <span class="lp-theme-hero-orb"></span>
      <iconify-icon icon="hugeicons:user-circle" width="88" height="88"></iconify-icon>
    </div>
  </section>

  <div class="lp-tabs lp-tabs-block lp-profile-tabs" role="tablist" aria-label="{{strings.profile_tabs_aria}}">
    <a class="lp-tab{{#ptab_overview}} is-on{{/ptab_overview}}"
       role="tab"
       data-lp-profile-tab="overview"
       href="{{tab_overview_url}}"
       aria-selected="{{#ptab_overview}}true{{/ptab_overview}}{{^ptab_overview}}false{{/ptab_overview}}">
      {{strings.profile_tab_overview}}
    </a>
    <a class="lp-tab{{#ptab_edit}} is-on{{/ptab_edit}}"
       role="tab"
       data-lp-profile-tab="edit"
       href="{{tab_edit_url}}"
       aria-selected="{{#ptab_edit}}true{{/ptab_edit}}{{^ptab_edit}}false{{/ptab_edit}}">
      {{strings.profile_tab_edit}}
    </a>
    <a class="lp-tab{{#ptab_preferences}} is-on{{/ptab_preferences}}"
       role="tab"
       data-lp-profile-tab="preferences"
       href="{{tab_preferences_url}}"
       aria-selected="{{#ptab_preferences}}true{{/ptab_preferences}}{{^ptab_preferences}}false{{/ptab_preferences}}">
      {{strings.profile_tab_preferences}}
    </a>
  </div>

  <div data-lp-profile-panel="overview" {{^ptab_overview}}hidden{{/ptab_overview}}>
    {{#has_sections}}
      <div class="lp-profile-sections">
        {{#sections}}
          <section class="lp-card lift lp-profile-section">
            <div class="lp-card-head">
              <h3>{{title}}</h3>
            </div>
            <dl class="lp-theme-kv lp-profile-kv">
              {{#rows}}
                <div class="lp-theme-kv-row">
                  <dt>{{label}}</dt>
                  <dd>{{#is_html}}{{{value}}}{{/is_html}}{{^is_html}}{{value}}{{/is_html}}</dd>
                </div>
              {{/rows}}
            </dl>
          </section>
        {{/sections}}
      </div>
    {{/has_sections}}
    {{^has_sections}}
      <div class="lp-empty" role="status">
        <h2>{{strings.profile_empty_title}}</h2>
        <p>{{strings.profile_empty_body}}</p>
        <div class="lp-empty-actions">
          <a class="lp-btn" href="{{tab_edit_url}}" data-lp-profile-tab="edit">{{strings.profile_edit_cta}}</a>
        </div>
      </div>
    {{/has_sections}}

    {{#has_course_details}}
      <section class="lp-card lift lp-profile-section lp-profile-courses" data-region="profile-course-details">
        <div class="lp-card-head">
          <div class="lp-card-copy">
            <h3>{{strings.profile_course_details_title}}</h3>
            <p>{{strings.profile_course_details_help}}</p>
          </div>
        </div>
        <ul class="lp-profile-course-list">
          {{#course_details}}
            <li class="lp-profile-course-item">
              <a class="lp-profile-course-link" href="{{url}}">
                <span class="lp-grade-progress-icon is-sm" aria-hidden="true">
                  <iconify-icon icon="hugeicons:student" width="18" height="18"></iconify-icon>
                </span>
                <span class="lp-profile-course-copy">
                  <b>{{{name}}}</b>
                  {{#meta}}<span class="lp-muted lp-sm">{{meta}}</span>{{/meta}}
                </span>
                <span class="lp-chip">{{role}}</span>
                <iconify-icon icon="hugeicons:arrow-right-01" width="16" height="16" aria-hidden="true"></iconify-icon>
              </a>
            </li>
          {{/course_details}}
        </ul>
      </section>
    {{/has_course_details}}
  </div>

  <div data-lp-profile-panel="edit" {{^ptab_edit}}hidden{{/ptab_edit}}>
    {{#can_edit}}
      {{#form}}
        <form class="lp-card lift lp-profile-form" method="post" action="{{action_url}}">
          <input type="hidden" name="sesskey" value="{{sesskey}}">
          <input type="hidden" name="action" value="update_profile">
          <div class="lp-card-head">
            <div class="lp-grade-progress-title">
              <span class="lp-grade-progress-icon" aria-hidden="true">
                <iconify-icon icon="hugeicons:user-edit-01" width="22" height="22"></iconify-icon>
              </span>
              <div class="lp-card-copy">
                <h3>{{strings.profile_edit_heading}}</h3>
                <p>{{strings.profile_edit_help}}</p>
              </div>
            </div>
            {{^hide_moodle_escapes}}
              <a class="lp-btn lp-btn-light" href="{{moodle_edit_url}}">{{strings.profile_edit_moodle}}</a>
            {{/hide_moodle_escapes}}
          </div>

          <div class="lp-profile-form-grid">
            {{#fields}}
              <label class="lp-field{{#locked}} is-locked{{/locked}}">
                <span>{{label}}{{#required}} *{{/required}}</span>
                {{#is_text}}
                  <input type="{{inputtype}}"
                         name="{{name}}"
                         value="{{value}}"
                         {{#required}}required{{/required}}
                         {{#locked}}readonly{{/locked}}>
                {{/is_text}}
                {{#is_textarea}}
                  <textarea name="{{name}}" rows="4" {{#locked}}readonly{{/locked}}>{{value}}</textarea>
                {{/is_textarea}}
                {{#is_select}}
                  <div class="lp-select{{#locked}} is-locked{{/locked}}" data-lp-select>
                    <button type="button"
                            class="lp-select-trigger"
                            data-lp-select-trigger
                            aria-haspopup="listbox"
                            aria-expanded="false"
                            {{#locked}}disabled{{/locked}}>
                      <span class="lp-select-value" data-lp-select-label>{{#options}}{{#selected}}{{label}}{{/selected}}{{/options}}</span>
                      <iconify-icon icon="hugeicons:arrow-down-01" width="16" height="16" aria-hidden="true"></iconify-icon>
                    </button>
                    <ul class="lp-select-menu" data-lp-select-menu hidden role="listbox">
                      {{#options}}
                        <li role="option"
                            class="lp-select-option{{#selected}} is-selected{{/selected}}"
                            data-lp-select-option
                            data-value="{{value}}"
                            tabindex="-1"
                            {{#selected}}aria-selected="true"{{/selected}}>{{label}}</li>
                      {{/options}}
                    </ul>
                    <select name="{{name}}"
                            class="lp-select-native"
                            data-lp-select-input
                            tabindex="-1"
                            aria-hidden="true"
                            {{#locked}}disabled{{/locked}}>
                      {{#options}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                      {{/options}}
                    </select>
                    {{#locked}}
                      <input type="hidden" name="{{name}}" value="{{#options}}{{#selected}}{{value}}{{/selected}}{{/options}}">
                    {{/locked}}
                  </div>
                {{/is_select}}
              </label>
            {{/fields}}
          </div>

          {{#has_custom_fields}}
            <div class="lp-profile-form-custom">
              <h4>{{strings.profile_custom_heading}}</h4>
              <div class="lp-profile-form-grid">
                {{#custom_fields}}
                  <label class="lp-field{{#locked}} is-locked{{/locked}}">
                    <span>{{label}}</span>
                    {{#is_text}}
                      <input type="text" name="{{name}}" value="{{value}}" {{#locked}}readonly{{/locked}}>
                    {{/is_text}}
                    {{#is_textarea}}
                      <textarea name="{{name}}" rows="3" {{#locked}}readonly{{/locked}}>{{value}}</textarea>
                    {{/is_textarea}}
                  </label>
                {{/custom_fields}}
              </div>
            </div>
          {{/has_custom_fields}}

          <p class="lp-xs lp-muted">{{strings.profile_edit_note}}</p>
          <div class="lp-profile-form-actions">
            <button type="submit" class="lp-btn lp-btn-primary">{{strings.profile_save}}</button>
            <a class="lp-btn lp-btn-light" href="{{tab_overview_url}}" data-lp-profile-tab="overview">{{strings.profile_cancel}}</a>
          </div>
        </form>
      {{/form}}
    {{/can_edit}}
    {{^can_edit}}
      <div class="lp-empty" role="status">
        <h2>{{strings.profile_edit_unavailable_title}}</h2>
        <p>{{strings.profile_edit_unavailable_body}}</p>
        <div class="lp-empty-actions">
          {{#has_edit_external}}
            <a class="lp-btn" href="{{edit_external_url}}">{{strings.profile_edit_external}}</a>
          {{/has_edit_external}}
          {{^has_edit_external}}
            {{^hide_moodle_escapes}}
              <a class="lp-btn" href="{{moodle_edit_url}}">{{strings.profile_edit_moodle}}</a>
            {{/hide_moodle_escapes}}
          {{/has_edit_external}}
        </div>
      </div>
    {{/can_edit}}
  </div>

  <div data-lp-profile-panel="preferences" {{^ptab_preferences}}hidden{{/ptab_preferences}}>
    <div class="lp-profile-prefs" data-lp-profile-pref-hub {{#has_pref_detail}}hidden{{/has_pref_detail}}>
      <p class="lp-sm lp-muted lp-profile-prefs-lead">{{strings.profile_prefs_lead}}</p>
      {{#has_preference_groups}}
        {{#preference_groups}}
          <section class="lp-card lift lp-profile-pref-group">
            <div class="lp-card-head">
              <h3>{{title}}</h3>
            </div>
            <ul class="lp-profile-pref-list">
              {{#items}}
                <li>
                  <a class="lp-profile-pref-item" href="{{url}}">
                    <span class="lp-grade-progress-icon is-sm" aria-hidden="true">
                      <iconify-icon icon="hugeicons:{{icon}}" width="18" height="18"></iconify-icon>
                    </span>
                    <span class="lp-profile-pref-copy">
                      <b>{{label}}</b>
                      <span>{{desc}}</span>
                    </span>
                    <iconify-icon icon="hugeicons:arrow-right-01" width="16" height="16" aria-hidden="true"></iconify-icon>
                  </a>
                </li>
              {{/items}}
            </ul>
          </section>
        {{/preference_groups}}
      {{/has_preference_groups}}
      <p class="lp-xs lp-muted">{{strings.native_tools_note}}</p>
    </div>
    {{#has_pref_detail}}
      <div data-lp-profile-pref-detail>
        {{> local_launchpad/employer_profile_pref}}
      </div>
    {{/has_pref_detail}}
  </div>
</div>
